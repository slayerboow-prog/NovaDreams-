            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- DataService: carga y guarda los datos de cada jugador (dinero, casa, estadísticas...)
--
-- Detalles importantes para que NUNCA se pierda ni se duplique dinero:
--  * "Session lock": mientras un servidor tiene cargados tus datos, ningún otro
--    servidor puede sobrescribirlos (evita duplicar dinero saltando de servidor).
--  * Autoguardado cada Config.AutosaveSeconds y al salir / cerrar el servidor.
--  * En Roblox Studio, si no has activado "Enable Studio Access to API Services",
--    el juego funciona igual pero sin guardar (te avisa en la consola).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local DataService = {}

local LOCK_TIMEOUT = Config.AutosaveSeconds * 3
local MAX_RECEIPTS = 50

local DEFAULT_DATA = {
	Money = Config.StartingMoney,
	HouseTier = 1,
	Hunger = Config.Needs.Max,
	Energy = Config.Needs.Max,
	Stats = {
		TasksDone = 0,
		MoneyEarned = 0,
		PlaySeconds = 0,
	},
	ProcessedReceipts = {},
}

local profiles: { [Player]: { [string]: any } } = {}
local loadedCallbacks: { (Player, { [string]: any }) -> () } = {}
local savingEnabled = true
local store: DataStore? = nil

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

-- Añade los campos nuevos que falten (para cuando actualices el juego).
local function reconcile(data: { [string]: any }, template: { [string]: any })
	for key, value in template do
		if data[key] == nil then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil then
			reconcile(data[key], value)
		end
	end
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		savingEnabled = false
		warn("[DataService] DataStore no disponible, los datos NO se guardarán:", result)
	end
end

-- Devuelve la tabla de datos o nil si no se pudo cargar.
local function loadFromStore(player: Player): { [string]: any }?
	if not savingEnabled or not store then
		return deepCopy(DEFAULT_DATA)
	end

	for attempt = 1, 5 do
		local loaded: { [string]: any }? = nil
		local locked = false
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(keyFor(player), function(old)
				local data = if type(old) == "table" then old else deepCopy(DEFAULT_DATA)
				local lock = data.SessionLock
				if lock and lock.JobId ~= game.JobId and os.time() - (lock.Time or 0) < LOCK_TIMEOUT then
					locked = true
					return nil -- no escribir nada, otro servidor tiene los datos
				end
				locked = false
				data.SessionLock = { JobId = game.JobId, Time = os.time() }
				loaded = data
				return data
			end)
		end)

		if ok and loaded then
			return loaded
		end

		if not ok then
			warn(("[DataService] Error cargando %s (intento %d): %s"):format(player.Name, attempt, tostring(err)))
			if RunService:IsStudio() then
				savingEnabled = false
				warn("[DataService] Estás en Studio sin acceso a la API. Activa 'Enable Studio Access to API Services' en Game Settings > Security para probar el guardado.")
				return deepCopy(DEFAULT_DATA)
			end
		elseif locked then
			warn(("[DataService] Datos de %s bloqueados por otro servidor, reintentando..."):format(player.Name))
		end

		if not player.Parent then
			return nil
		end
		task.wait(attempt * 2)
	end
	return nil
end

-- Guarda los datos. release = true suelta el session lock (al salir).
function DataService.save(player: Player, release: boolean?): boolean
	local data = profiles[player]
	if not data then
		return false
	end
	if not savingEnabled or not store then
		return true -- en Studio sin API damos el guardado por bueno
	end

	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(keyFor(player), function(old)
			if type(old) == "table" and old.SessionLock and old.SessionLock.JobId ~= game.JobId then
				return nil -- otro servidor se ha quedado los datos: no pisarlos
			end
			local toSave = deepCopy(data)
			toSave.SessionLock = if release then nil else { JobId = game.JobId, Time = os.time() }
			return toSave
		end)
	end)
	if not ok then
		warn(("[DataService] Error guardando %s: %s"):format(player.Name, tostring(err)))
	end
	return ok
end

-- Devuelve los datos del jugador (nil si todavía no han cargado).
function DataService.get(player: Player): { [string]: any }?
	return profiles[player]
end

-- Espera a que carguen los datos (máx. timeout segundos).
function DataService.waitFor(player: Player, timeout: number?): { [string]: any }?
	local deadline = os.clock() + (timeout or 15)
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

-- Registra una función que se llama cuando los datos de un jugador están listos.
function DataService.onLoaded(callback: (Player, { [string]: any }) -> ())
	table.insert(loadedCallbacks, callback)
	for player, data in profiles do
		task.spawn(callback, player, data)
	end
end

---------------------------------------------------------------------
-- Dinero
---------------------------------------------------------------------

local function syncMoney(player: Player, data: { [string]: any })
	player:SetAttribute("Money", data.Money)
	local leaderstats = player:FindFirstChild("leaderstats")
	local money = leaderstats and leaderstats:FindFirstChild("Dinero")
	if money then
		(money :: IntValue).Value = data.Money
	end
end

-- Suma (o resta, si amount es negativo) dinero. Devuelve false si no hay datos.
function DataService.addMoney(player: Player, amount: number, isEarning: boolean?): boolean
	local data = profiles[player]
	if not data then
		return false
	end
	data.Money = math.max(0, math.floor(data.Money + amount))
	if isEarning and amount > 0 then
		data.Stats.MoneyEarned += amount
	end
	syncMoney(player, data)
	return true
end

-- Cobra un precio si hay dinero suficiente. Devuelve true si se ha pagado.
function DataService.spend(player: Player, price: number): boolean
	local data = profiles[player]
	if not data or data.Money < price then
		return false
	end
	data.Money -= price
	syncMoney(player, data)
	return true
end

function DataService.hasProcessedReceipt(player: Player, purchaseId: string): boolean
	local data = profiles[player]
	return data ~= nil and table.find(data.ProcessedReceipts, purchaseId) ~= nil
end

function DataService.markReceipt(player: Player, purchaseId: string)
	local data = profiles[player]
	if not data then
		return
	end
	table.insert(data.ProcessedReceipts, purchaseId)
	while #data.ProcessedReceipts > MAX_RECEIPTS do
		table.remove(data.ProcessedReceipts, 1)
	end
end

---------------------------------------------------------------------
-- Ciclo de vida
---------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local money = Instance.new("IntValue")
	money.Name = "Dinero"
	money.Parent = leaderstats
	leaderstats.Parent = player

	local data = loadFromStore(player)
	if not player.Parent then
		return -- se fue mientras cargaba
	end
	if not data then
		player:Kick("No hemos podido cargar tus datos. Vuelve a entrar en unos segundos.")
		return
	end

	reconcile(data, DEFAULT_DATA)
	profiles[player] = data
	syncMoney(player, data)

	for _, callback in loadedCallbacks do
		task.spawn(callback, player, data)
	end
end

local function onPlayerRemoving(player: Player)
	if profiles[player] then
		DataService.save(player, true)
		profiles[player] = nil
	end
end

function DataService.init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- Autoguardado + contador de tiempo jugado
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player, data in profiles do
				data.Stats.PlaySeconds += Config.AutosaveSeconds
				task.spawn(DataService.save, player)
			end
		end
	end)

	-- Al cerrar el servidor, guardar a todos
	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">FoodService</string>
            <string name="Source"><![CDATA[-- FoodService: comprar comida en los mostradores (tag "FoodStand" + atributo FoodId).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Builder = require(script.Parent.Parent.World.Builder)
local DataService = require(script.Parent.DataService)
local NeedsService = require(script.Parent.NeedsService)

local FoodService = {}

local Notify = ReplicatedStorage.Remotes.Notify :: RemoteEvent
local lastUse: { [Player]: { [string]: number } } = {}

function FoodService.eat(player: Player, foodId: string, stand: BasePart?)
	local food = Config.Foods[foodId]
	if not food or not DataService.get(player) then
		return
	end

	-- La nevera solo funciona en tu propia casa
	if stand and stand:GetAttribute("PlotId") and stand:GetAttribute("PlotId") ~= player:GetAttribute("PlotId") then
		Notify:FireClient(player, "Error", "Esta nevera no es tuya.")
		return
	end

	if food.Cooldown then
		lastUse[player] = lastUse[player] or {}
		local last = lastUse[player][foodId]
		if last and os.clock() - last < food.Cooldown then
			local left = math.ceil(food.Cooldown - (os.clock() - last))
			Notify:FireClient(player, "Error", ("La nevera está vacía. Vuelve en %d s."):format(left))
			return
		end
	end

	if food.Price > 0 and not DataService.spend(player, food.Price) then
		Notify:FireClient(player, "Error", "No tienes suficiente dinero.")
		return
	end

	if food.Cooldown then
		lastUse[player][foodId] = os.clock()
	end
	NeedsService.change(player, food.Hunger, food.Energy or 0)
	Notify:FireClient(player, "Food", ("¡Ñam! %s"):format(food.Name))
end

local function setupStand(stand: Instance)
	if not stand:IsA("BasePart") then
		return
	end
	local foodId = stand:GetAttribute("FoodId")
	local food = Config.Foods[foodId]
	if not food then
		warn("[FoodService] FoodStand con FoodId desconocido:", foodId)
		return
	end
	local action = if food.Price > 0 then "Comprar" else "Comer"
	local object = if food.Price > 0 then ("%s · %s"):format(food.Name, Format.money(food.Price)) else food.Name
	local prompt = Builder.prompt(stand, action, object, 0.3)
	prompt.Triggered:Connect(function(player)
		FoodService.eat(player, foodId, stand)
	end)
end

function FoodService.init()
	for _, stand in CollectionService:GetTagged("FoodStand") do
		setupStand(stand)
	end
	CollectionService:GetInstanceAddedSignal("FoodStand"):Connect(setupStand)

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastUse[player] = nil
	end)
end

return FoodService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">HouseService</string>
            <string name="Source"><![CDATA[-- HouseService: parcelas y casas.
--  * Cada jugador puede reclamar UNA parcela libre del servidor (gratis).
--  * El nivel de su casa (Config.HouseTiers) se guarda y se puede mejorar con dinero.
--  * Dentro hay cama (dormir = recuperar energía) y nevera (comida gratis con espera).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Builder = require(script.Parent.Parent.World.Builder)
local Building = require(script.Parent.Parent.World.Kit.Building)
local TownBuilder = require(script.Parent.Parent.World.TownBuilder)
local DataService = require(script.Parent.DataService)
local NeedsService = require(script.Parent.NeedsService)

local HouseService = {}

local Notify = ReplicatedStorage.Remotes.Notify :: RemoteEvent

type Plot = {
	Id: number,
	Model: Model,
	Origin: CFrame,
	SignLabel: TextLabel,
	Prompt: ProximityPrompt,
	Owner: Player?,
	House: Model?,
}
local plots: { [number]: Plot } = {}

local function plotOf(player: Player): Plot?
	local id = player:GetAttribute("PlotId")
	return if id then plots[id] else nil
end

---------------------------------------------------------------------
-- Construcción de la casa
---------------------------------------------------------------------

local WOOD = Color3.fromRGB(96, 66, 48)

local function furnish(model: Model, at: (number, number, number) -> CFrame, size: Vector3, plotId: number)
	-- "at" usa coordenadas interiores: y = 0 es el suelo, -Z es la fachada (puerta)
	local W, D = size.X, size.Z

	-- DORMITORIO: cama al fondo a la derecha
	local bedCf = at(W / 2 - 4.5, 0, D / 2 - 5.5)
	Builder.part({ Name = "BedFrame", Size = Vector3.new(6, 1.4, 8), CFrame = bedCf * CFrame.new(0, 0.7, 0), Color = WOOD, Material = Enum.Material.Wood, Parent = model })
	local mattress = Builder.part({
		Name = "Bed",
		Size = Vector3.new(5.6, 0.8, 7.6),
		CFrame = bedCf * CFrame.new(0, 1.8, 0),
		Color = Color3.fromRGB(238, 238, 242),
		Material = Enum.Material.Fabric,
		Tags = { "Bed" },
		Attributes = { PlotId = plotId },
		Parent = model,
	})
	Builder.decor({ Name = "Blanket", Size = Vector3.new(5.8, 0.3, 4.6), CFrame = bedCf * CFrame.new(0, 2.3, -1.4), Color = Color3.fromRGB(70, 110, 180), Material = Enum.Material.Fabric, Parent = model })
	Builder.decor({ Name = "Pillow", Size = Vector3.new(4, 0.6, 1.6), CFrame = bedCf * CFrame.new(0, 2.5, 2.8), Color = Color3.new(1, 1, 1), Material = Enum.Material.Fabric, Parent = model })
	Builder.part({ Name = "Headboard", Size = Vector3.new(6, 4, 0.5), CFrame = bedCf * CFrame.new(0, 2, 4.1), Color = WOOD, Material = Enum.Material.Wood, Parent = model })
	Builder.part({ Name = "Nightstand", Size = Vector3.new(2, 2.2, 2), CFrame = at(W / 2 - 9, 1.1, D / 2 - 2.2), Color = WOOD, Material = Enum.Material.Wood, Parent = model })
	local lamp = Builder.decor({ Name = "BedLamp", Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 1.2, 1.2), CFrame = at(W / 2 - 9, 2.9, D / 2 - 2.2), Color = Color3.fromRGB(255, 236, 200), Material = Enum.Material.Neon, Parent = model })
	local lampLight = Instance.new("PointLight")
	lampLight.Range = 10
	lampLight.Brightness = 0.8
	lampLight.Color = Color3.fromRGB(255, 214, 160)
	lampLight.Parent = lamp

	local sleep = Builder.prompt(mattress, "Dormir", "Cama", 0.5)
	sleep.Triggered:Connect(function(player)
		HouseService.sleep(player, plotId)
	end)

	-- COCINA: nevera y encimera al fondo a la izquierda
	Builder.part({ Name = "FridgeBody", Size = Vector3.new(3.2, 7, 3), CFrame = at(-W / 2 + 2.6, 3.5, D / 2 - 2.5), Color = Color3.fromRGB(226, 229, 233), Material = Enum.Material.Metal, Parent = model })
	Builder.part({
		Name = "Fridge",
		Size = Vector3.new(0.3, 1.4, 0.3),
		CFrame = at(-W / 2 + 3.6, 4.2, D / 2 - 4.15),
		Color = Color3.fromRGB(90, 90, 96),
		Tags = { "FoodStand" },
		Attributes = { FoodId = "Nevera", PlotId = plotId },
		Parent = model,
	})
	Builder.part({ Name = "KitchenCounter", Size = Vector3.new(6, 3.6, 2.6), CFrame = at(-W / 2 + 7.4, 1.8, D / 2 - 2.3), Color = Color3.fromRGB(240, 238, 232), Material = Enum.Material.Plaster, Parent = model })
	Builder.decor({ Name = "Worktop", Size = Vector3.new(6.2, 0.3, 2.8), CFrame = at(-W / 2 + 7.4, 3.75, D / 2 - 2.3), Color = Color3.fromRGB(60, 62, 66), Material = Enum.Material.Granite, Parent = model })

	-- SALÓN: sofá mirando a la tele, alfombra y mesa baja
	local sofaCf = at(-W / 2 + 3, 0, -2) * CFrame.Angles(0, math.rad(-90), 0)
	local sofaColor = Color3.fromRGB(116, 128, 140)
	Builder.part({ Name = "SofaSeat", Size = Vector3.new(9, 1.6, 3.4), CFrame = sofaCf * CFrame.new(0, 1, 0), Color = sofaColor, Material = Enum.Material.Fabric, Parent = model })
	Builder.part({ Name = "SofaBack", Size = Vector3.new(9, 3, 1), CFrame = sofaCf * CFrame.new(0, 2.2, 1.6), Color = sofaColor, Material = Enum.Material.Fabric, Parent = model })
	for _, x in { -4.8, 4.8 } do
		Builder.part({ Name = "SofaArm", Size = Vector3.new(0.8, 2.4, 3.4), CFrame = sofaCf * CFrame.new(x, 1.6, 0), Color = sofaColor, Material = Enum.Material.Fabric, Parent = model })
	end
	Builder.decor({ Name = "Rug", Size = Vector3.new(6, 0.1, 8), CFrame = at(-W / 2 + 8.5, 0.05, -2), Color = Color3.fromRGB(176, 88, 68), Material = Enum.Material.Fabric, Parent = model })
	Builder.part({ Name = "CoffeeTable", Size = Vector3.new(2.5, 1.4, 4), CFrame = at(-W / 2 + 8, 0.7, -2), Color = WOOD, Material = Enum.Material.Wood, Parent = model })
	Builder.part({ Name = "TVStand", Size = Vector3.new(1.6, 2, 5), CFrame = at(2, 1, -2), Color = WOOD, Material = Enum.Material.Wood, Parent = model })
	Builder.decor({ Name = "TV", Size = Vector3.new(0.3, 3, 5), CFrame = at(2, 3.6, -2), Color = Color3.fromRGB(18, 18, 22), Material = Enum.Material.Glass, Parent = model })

	-- Planta junto a la entrada
	Builder.part({ Name = "Pot", Size = Vector3.new(1.6, 1.6, 1.6), CFrame = at(W / 2 - 2, 0.8, -D / 2 + 2), Color = Color3.fromRGB(170, 90, 60), Material = Enum.Material.Plaster, Parent = model })
	Builder.decor({ Name = "Plant", Shape = Enum.PartType.Ball, Size = Vector3.new(2.6, 2.6, 2.6), CFrame = at(W / 2 - 2, 2.6, -D / 2 + 2), Color = Color3.fromRGB(70, 124, 58), Material = Enum.Material.LeafyGrass, Parent = model })
end

local function buildHouse(plot: Plot, tier: number)
	if plot.House then
		plot.House:Destroy()
		plot.House = nil
	end
	local info = Config.HouseTiers[tier]
	local size = info.Size
	-- Colocamos la casa hacia el fondo de la parcela (50x50), dejando jardín delante
	local offsetZ = 25 - size.Z / 2 - 3
	local model, at = Building.build({
		Name = "House",
		Parent = plot.Model,
		CFrame = plot.Origin * CFrame.new(0, 0, offsetZ),
		Width = size.X,
		Depth = size.Z,
		Floors = if size.Y >= 16 then 2 else 1,
		Style = "Casa",
		GroundFloor = "House",
		WallColor = info.Color,
		FloorColor = Color3.fromRGB(176, 136, 98),
	})
	furnish(model, at, size, plot.Id)
	plot.House = model
end

local function refreshSign(plot: Plot)
	local owner = plot.Owner
	if not owner then
		plot.SignLabel.Text = "SE VENDE\nLibre"
		plot.Prompt.ActionText = "Reclamar casa"
		plot.Prompt.ObjectText = "Parcela " .. plot.Id .. " · Gratis"
		return
	end
	local data = DataService.get(owner)
	local tier = if data then data.HouseTier else 1
	local nextTier = Config.HouseTiers[tier + 1]
	plot.SignLabel.Text = ("%s\n%s"):format(owner.DisplayName, Config.HouseTiers[tier].Name)
	if nextTier then
		plot.Prompt.ActionText = "Mejorar a " .. nextTier.Name
		plot.Prompt.ObjectText = Format.money(nextTier.Price)
	else
		plot.Prompt.ActionText = "Casa al máximo"
		plot.Prompt.ObjectText = Config.HouseTiers[tier].Name
	end
end

---------------------------------------------------------------------
-- Acciones
---------------------------------------------------------------------

function HouseService.claim(player: Player, plot: Plot)
	local data = DataService.get(player)
	if not data then
		return
	end
	if plotOf(player) then
		Notify:FireClient(player, "Error", "Ya tienes una casa en este servidor.")
		return
	end
	plot.Owner = player
	player:SetAttribute("PlotId", plot.Id)
	buildHouse(plot, data.HouseTier)
	refreshSign(plot)
	Notify:FireClient(player, "Success", "¡Bienvenido a tu nueva casa! Pulsa 'Casa' para volver cuando quieras.")
end

function HouseService.upgrade(player: Player, plot: Plot)
	local data = DataService.get(player)
	if not data then
		return
	end
	local nextTier = Config.HouseTiers[data.HouseTier + 1]
	if not nextTier then
		Notify:FireClient(player, "Info", "Tu casa ya es la mejor de la ciudad.")
		return
	end
	if not DataService.spend(player, nextTier.Price) then
		Notify:FireClient(player, "Error", ("Necesitas %s para mejorar tu casa."):format(Format.money(nextTier.Price)))
		return
	end
	data.HouseTier += 1
	buildHouse(plot, data.HouseTier)
	refreshSign(plot)
	Notify:FireClient(player, "Success", ("¡Enhorabuena! Ahora vives en: %s"):format(nextTier.Name))
end

function HouseService.release(player: Player)
	local plot = plotOf(player)
	if not plot then
		return
	end
	if plot.House then
		plot.House:Destroy()
	end
	plot.House = TownBuilder.showHouse(plot.Model, plot.Origin)
	plot.Owner = nil
	player:SetAttribute("PlotId", nil)
	refreshSign(plot)
end

function HouseService.sleep(player: Player, plotId: number)
	if player:GetAttribute("PlotId") ~= plotId then
		Notify:FireClient(player, "Error", "Esta cama no es tuya.")
		return
	end
	if player:GetAttribute("Sleeping") then
		return
	end
	player:SetAttribute("Sleeping", true)
	Notify:FireClient(player, "Sleep", "Zzz...")
	task.wait(Config.SleepSeconds)
	if player.Parent then
		player:SetAttribute("Sleeping", nil)
		NeedsService.change(player, 0, Config.Needs.Max)
		Notify:FireClient(player, "Success", "Has dormido genial. ¡Energía al máximo!")
	end
end

function HouseService.goHome(player: Player)
	local plot = plotOf(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not plot then
		Notify:FireClient(player, "Error", "Aún no tienes casa. Busca un cartel de SE VENDE en la zona residencial.")
		return
	end
	if root then
		player.Character:PivotTo(plot.Origin * CFrame.new(0, 4, -23.5) * CFrame.Angles(0, math.pi, 0))
	end
end

---------------------------------------------------------------------

function HouseService.init()
	for _, model in CollectionService:GetTagged("Plot") do
		local id = model:GetAttribute("PlotId")
		local sign = model:FindFirstChild("PlotSign") :: BasePart
		local label = sign:FindFirstChild("Label", true) :: TextLabel
		local prompt = Builder.prompt(sign, "Reclamar casa", "", 0.5)
		local plot: Plot = {
			Id = id,
			Model = model,
			Origin = model:GetAttribute("Origin"),
			SignLabel = label,
			Prompt = prompt,
			House = model:FindFirstChild("House") :: Model?, -- casa de muestra "en venta"
		}
		plots[id] = plot
		refreshSign(plot)

		prompt.Triggered:Connect(function(player)
			if plot.Owner == nil then
				HouseService.claim(player, plot)
			elseif plot.Owner == player then
				HouseService.upgrade(player, plot)
			else
				Notify:FireClient(player, "Info", ("Esta es la casa de %s."):format(plot.Owner.DisplayName))
			end
		end)
	end

	local GoHome = ReplicatedStorage.Remotes.GoHome :: RemoteEvent
	GoHome.OnServerEvent:Connect(HouseService.goHome)

	Players.PlayerRemoving:Connect(HouseService.release)
end

return HouseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">JobService</string>
            <string name="Source"><![CDATA[-- JobService: trabajos. Cada trabajo es un bucle:
--   1) ir al punto de recogida (Pickup_<Trabajo>)  -> el personaje coge el objeto
--   2) llevarlo al punto de entrega (Dropoff_<Trabajo>) -> cobras
--
-- El servidor comprueba la distancia (no se fía del cliente) y le pasa al
-- cliente el objetivo actual con atributos: "Job", "TaskTarget", "TaskText".

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Builder = require(script.Parent.Parent.World.Builder)
local DataService = require(script.Parent.DataService)
local NeedsService = require(script.Parent.NeedsService)
local MonetizationService = require(script.Parent.MonetizationService)

local JobService = {}

local Notify = ReplicatedStorage.Remotes.Notify :: RemoteEvent

type Shift = {
	JobId: string,
	Phase: "Pickup" | "Dropoff",
	Target: BasePart,
	Carry: BasePart?,
}
local shifts: { [Player]: Shift } = {}

local function pickTarget(tag: string, avoid: BasePart?): BasePart?
	local options = CollectionService:GetTagged(tag)
	if #options == 0 then
		warn("[JobService] No hay partes con el tag", tag)
		return nil
	end
	if #options > 1 and avoid then
		local index = table.find(options, avoid)
		if index then
			table.remove(options, index)
		end
	end
	return options[math.random(1, #options)]
end

local function removeCarry(shift: Shift)
	if shift.Carry then
		shift.Carry:Destroy()
		shift.Carry = nil
	end
end

-- Pone un objeto (caja, café, bolsa...) en las manos del personaje.
local function giveCarry(player: Player, shift: Shift)
	removeCarry(shift)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local job = Config.Jobs[shift.JobId]
	local item = Instance.new("Part")
	item.Name = "CarriedItem"
	item.Size = job.CarrySize
	item.Color = job.CarryColor
	item.Material = Enum.Material.SmoothPlastic
	item.CanCollide = false
	item.CanQuery = false
	item.Massless = true
	item.CFrame = root.CFrame * CFrame.new(0, 0, -1.8)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = item
	weld.Parent = item
	item.Parent = character
	shift.Carry = item
end

local function publish(player: Player, shift: Shift)
	local job = Config.Jobs[shift.JobId]
	player:SetAttribute("TaskTarget", shift.Target.Position)
	player:SetAttribute("TaskText", if shift.Phase == "Pickup" then job.PickupText else job.DropoffText)
end

local function nextTask(player: Player, shift: Shift, lastTarget: BasePart?)
	local target = pickTarget("Pickup_" .. shift.JobId, lastTarget)
	if not target then
		return
	end
	shift.Phase = "Pickup"
	shift.Target = target
	publish(player, shift)
end

function JobService.quit(player: Player, silent: boolean?)
	local shift = shifts[player]
	if not shift then
		return
	end
	removeCarry(shift)
	shifts[player] = nil
	player:SetAttribute("Job", nil)
	player:SetAttribute("TaskTarget", nil)
	player:SetAttribute("TaskText", nil)
	if not silent then
		Notify:FireClient(player, "Info", "Has dejado el trabajo.")
	end
end

function JobService.start(player: Player, jobId: string)
	local job = Config.Jobs[jobId]
	if not job or not DataService.get(player) then
		return
	end
	if not NeedsService.canWork(player) then
		Notify:FireClient(player, "Error", "Estás demasiado cansado o hambriento para trabajar.")
		return
	end
	JobService.quit(player, true)

	local target = pickTarget("Pickup_" .. jobId)
	if not target then
		return
	end
	local shift: Shift = { JobId = jobId, Phase = "Pickup", Target = target }
	shifts[player] = shift
	player:SetAttribute("Job", jobId)
	publish(player, shift)
	Notify:FireClient(player, "Success", ("¡Contratado como %s! Sigue la línea azul."):format(job.DisplayName))
end

local function reached(player: Player, shift: Shift)
	local job = Config.Jobs[shift.JobId]
	if shift.Phase == "Pickup" then
		giveCarry(player, shift)
		local target = pickTarget("Dropoff_" .. shift.JobId, shift.Target)
		if not target then
			return
		end
		shift.Phase = "Dropoff"
		shift.Target = target
		publish(player, shift)
		return
	end

	-- Entrega completada: cobrar
	removeCarry(shift)
	local pay = math.floor(job.Pay * MonetizationService.payMultiplier(player))
	DataService.addMoney(player, pay, true)
	local data = DataService.get(player)
	if data then
		data.Stats.TasksDone += 1
	end
	NeedsService.change(player, 0, -job.EnergyCost)
	Notify:FireClient(player, "Money", "+" .. Format.money(pay))

	if not NeedsService.canWork(player) then
		JobService.quit(player, true)
		Notify:FireClient(player, "Error", "Estás agotado. Come algo o duerme antes de seguir trabajando.")
		return
	end
	nextTask(player, shift, shift.Target)
end

local function setupBoard(board: Instance)
	if not board:IsA("BasePart") then
		return
	end
	local jobId = board:GetAttribute("JobId")
	local job = Config.Jobs[jobId]
	if not job then
		warn("[JobService] JobBoard con JobId desconocido:", jobId)
		return
	end
	local prompt = Builder.prompt(board, "Trabajar", ("%s · %s/entrega"):format(job.DisplayName, Format.money(job.Pay)), 0.5)
	prompt.Triggered:Connect(function(player)
		if player:GetAttribute("Job") == jobId then
			JobService.quit(player)
		else
			JobService.start(player, jobId)
		end
	end)
end

function JobService.init()
	for _, board in CollectionService:GetTagged("JobBoard") do
		setupBoard(board)
	end
	CollectionService:GetInstanceAddedSignal("JobBoard"):Connect(setupBoard)

	local QuitJob = ReplicatedStorage.Remotes.QuitJob :: RemoteEvent
	QuitJob.OnServerEvent:Connect(function(player)
		JobService.quit(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		JobService.quit(player, true)
	end)

	-- Si el jugador muere, pierde lo que llevaba y vuelve a la fase de recogida
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			local shift = shifts[player]
			if shift then
				removeCarry(shift)
				nextTask(player, shift, nil)
			end
		end)
	end)

	-- Comprobar llegadas 4 veces por segundo
	task.spawn(function()
		while true do
			task.wait(0.25)
			for player, shift in shifts do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root and shift.Target.Parent then
					local offset = root.Position - shift.Target.Position
					local flat = Vector3.new(offset.X, 0, offset.Z).Magnitude
					if flat <= Config.TaskReachDistance and math.abs(offset.Y) < 12 then
						reached(player, shift)
					end
				end
			end
		end
	end)
end

return JobService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[-- MonetizationService: Game Passes y Developer Products (compras con Robux).
--
-- Game Pass  = se compra UNA vez y es para siempre (ej. VIP).
-- Dev Product = se puede comprar muchas veces (ej. paquetes de dinero).
--
-- Los IDs se configuran en Shared/Config.luau.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)

local MonetizationService = {}

local Notify = ReplicatedStorage.Remotes.Notify :: RemoteEvent

local function passAttribute(key: string): string
	return "Pass_" .. key
end

function MonetizationService.hasPass(player: Player, key: string): boolean
	return player:GetAttribute(passAttribute(key)) == true
end

-- Multiplicador de sueldo (VIP cobra el doble)
function MonetizationService.payMultiplier(player: Player): number
	if MonetizationService.hasPass(player, "VIP") then
		return Config.GamePasses.VIP.PayMultiplier
	end
	return 1
end

-- Multiplicador de gasto de hambre/energía (Metabolismo Pro gasta la mitad)
function MonetizationService.needsMultiplier(player: Player): number
	if MonetizationService.hasPass(player, "Metabolismo") then
		return Config.GamePasses.Metabolismo.NeedsMultiplier
	end
	return 1
end

local function checkPasses(player: Player)
	for key, pass in Config.GamePasses do
		if pass.Id ~= 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			if ok and owns then
				player:SetAttribute(passAttribute(key), true)
			end
		end
	end
end

local function processReceipt(receipt): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		-- El jugador se fue: Roblox lo volverá a intentar cuando vuelva
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local data = DataService.waitFor(player, 20)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- ¿Ya lo habíamos entregado? (Roblox puede repetir el aviso)
	if DataService.hasProcessedReceipt(player, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local product = nil
	for _, p in Config.DevProducts do
		if p.Id ~= 0 and p.Id == receipt.ProductId then
			product = p
			break
		end
	end
	if not product then
		warn("[Monetization] Producto desconocido:", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	DataService.addMoney(player, product.Cash)
	DataService.markReceipt(player, receipt.PurchaseId)

	-- Guardamos YA. Si falla, devolvemos NotProcessedYet y Roblox reintentará
	-- (el recibo queda marcado en memoria, así que en esta sesión no se duplica).
	if not DataService.save(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	Notify:FireClient(player, "Money", ("¡Gracias por tu compra! +%d"):format(product.Cash))
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.init()
	Players.PlayerAdded:Connect(checkPasses)
	for _, player in Players:GetPlayers() do
		task.spawn(checkPasses, player)
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for key, pass in Config.GamePasses do
			if pass.Id == passId then
				player:SetAttribute(passAttribute(key), true)
				Notify:FireClient(player, "Success", ("¡Ya tienes %s!"):format(pass.Name))
			end
		end
	end)

	MarketplaceService.ProcessReceipt = processReceipt
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">NeedsService</string>
            <string name="Source"><![CDATA[-- NeedsService: hambre y energía. Bajan con el tiempo; se recuperan comiendo y durmiendo.
-- Los valores se envían al cliente como atributos del jugador ("Hunger", "Energy").

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local MonetizationService = require(script.Parent.MonetizationService)

local NeedsService = {}

local TICK = 1 -- segundos entre actualizaciones
local MAX = Config.Needs.Max

local function clamp(value: number): number
	return math.clamp(value, 0, MAX)
end

local function applyWalkSpeed(player: Player)
	local data = DataService.get(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not data or not humanoid then
		return
	end
	local tired = data.Hunger <= Config.Needs.LowThreshold or data.Energy <= Config.Needs.LowThreshold
	humanoid.WalkSpeed = if tired then Config.TiredWalkSpeed else Config.WalkSpeed
end

local function sync(player: Player, data: { [string]: any })
	-- Redondeamos para no mandar un cambio de atributo por cada décima
	player:SetAttribute("Hunger", math.floor(data.Hunger + 0.5))
	player:SetAttribute("Energy", math.floor(data.Energy + 0.5))
	applyWalkSpeed(player)
end

-- Suma (o resta) hambre y energía.
function NeedsService.change(player: Player, hunger: number, energy: number)
	local data = DataService.get(player)
	if not data then
		return
	end
	data.Hunger = clamp(data.Hunger + hunger)
	data.Energy = clamp(data.Energy + energy)
	sync(player, data)
end

function NeedsService.canWork(player: Player): boolean
	local data = DataService.get(player)
	return data ~= nil
		and data.Hunger > Config.Needs.CantWorkThreshold
		and data.Energy > Config.Needs.CantWorkThreshold
end

function NeedsService.init()
	DataService.onLoaded(function(player, data)
		sync(player, data)
		player.CharacterAdded:Connect(function()
			task.defer(applyWalkSpeed, player)
		end)
		if player.Character then
			applyWalkSpeed(player)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(TICK)
			for _, player in Players:GetPlayers() do
				local data = DataService.get(player)
				if data and not player:GetAttribute("Sleeping") then
					local multiplier = MonetizationService.needsMultiplier(player)
					data.Hunger = clamp(data.Hunger - Config.Needs.HungerPerMinute / 60 * TICK * multiplier)
					data.Energy = clamp(data.Energy - Config.Needs.EnergyPerMinute / 60 * TICK * multiplier)
					sync(player, data)
				end
			end
		end
	end)
end

return NeedsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[-- WorldService: ciclo día/noche, farolas y efectos de iluminación para dar ambiente.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local WorldService = {}

local function ensure(className: string, props: { [string]: any })
	local instance = Lighting:FindFirstChildOfClass(className) or Instance.new(className)
	for key, value in props do
		(instance :: any)[key] = value
	end
	instance.Parent = Lighting
end

local function setupLighting()
	Lighting.ClockTime = Config.StartClockTime
	-- Los valores base vienen del archivo del juego (default.project.json); esto asegura que existen
	ensure("Atmosphere", {})
	ensure("BloomEffect", {})
	ensure("SunRaysEffect", {})
	ensure("ColorCorrectionEffect", {})
	ensure("Sky", {})
end

---------------------------------------------------------------------
-- Curva de iluminación por horas: el mismo mapa se ve distinto al amanecer,
-- de día, en la hora dorada, al anochecer y de noche.
---------------------------------------------------------------------
local rgb = Color3.fromRGB
type Key = { [string]: any }
local KEYS: { { Hour: number, Key: Key } } = {
	{ Hour = 0, Key = { Ambient = rgb(38, 42, 60), Outdoor = rgb(58, 64, 92), Brightness = 1.1, Exposure = -0.1, AtmColor = rgb(42, 52, 74), AtmDecay = rgb(20, 26, 42), Density = 0.36, Tint = rgb(196, 208, 255), Saturation = -0.05, Contrast = 0.16, Bloom = 1.1 } },
	{ Hour = 5.5, Key = { Ambient = rgb(46, 48, 66), Outdoor = rgb(70, 74, 100), Brightness = 1.2, Exposure = -0.05, AtmColor = rgb(70, 72, 96), AtmDecay = rgb(40, 40, 60), Density = 0.36, Tint = rgb(210, 214, 250), Saturation = 0, Contrast = 0.14, Bloom = 0.9 } },
	{ Hour = 7, Key = { Ambient = rgb(92, 80, 80), Outdoor = rgb(150, 130, 120), Brightness = 2.0, Exposure = 0.1, AtmColor = rgb(240, 202, 172), AtmDecay = rgb(140, 110, 110), Density = 0.3, Tint = rgb(255, 236, 216), Saturation = 0.12, Contrast = 0.12, Bloom = 0.6 } },
	{ Hour = 10, Key = { Ambient = rgb(70, 70, 78), Outdoor = rgb(128, 128, 136), Brightness = 2.6, Exposure = 0.15, AtmColor = rgb(206, 214, 224), AtmDecay = rgb(110, 120, 138), Density = 0.28, Tint = rgb(255, 250, 242), Saturation = 0.14, Contrast = 0.1, Bloom = 0.5 } },
	{ Hour = 16, Key = { Ambient = rgb(72, 70, 76), Outdoor = rgb(134, 128, 132), Brightness = 2.6, Exposure = 0.15, AtmColor = rgb(214, 214, 218), AtmDecay = rgb(120, 118, 130), Density = 0.28, Tint = rgb(255, 248, 238), Saturation = 0.14, Contrast = 0.1, Bloom = 0.5 } },
	{ Hour = 18.5, Key = { Ambient = rgb(100, 80, 70), Outdoor = rgb(172, 130, 108), Brightness = 2.4, Exposure = 0.2, AtmColor = rgb(255, 188, 138), AtmDecay = rgb(162, 100, 88), Density = 0.32, Tint = rgb(255, 222, 190), Saturation = 0.22, Contrast = 0.15, Bloom = 0.7 } },
	{ Hour = 20, Key = { Ambient = rgb(60, 54, 76), Outdoor = rgb(90, 80, 112), Brightness = 1.5, Exposure = 0, AtmColor = rgb(118, 108, 150), AtmDecay = rgb(58, 48, 80), Density = 0.34, Tint = rgb(222, 214, 255), Saturation = 0.05, Contrast = 0.15, Bloom = 0.9 } },
	{ Hour = 21.5, Key = { Ambient = rgb(38, 42, 60), Outdoor = rgb(58, 64, 92), Brightness = 1.1, Exposure = -0.1, AtmColor = rgb(42, 52, 74), AtmDecay = rgb(20, 26, 42), Density = 0.36, Tint = rgb(196, 208, 255), Saturation = -0.05, Contrast = 0.16, Bloom = 1.1 } },
}

local function lerp(a: any, b: any, t: number): any
	if typeof(a) == "Color3" then
		return (a :: Color3):Lerp(b, t)
	end
	return a + (b - a) * t
end

local function sample(hour: number): Key
	for i = 1, #KEYS do
		local a = KEYS[i]
		local b = KEYS[i + 1] or { Hour = KEYS[1].Hour + 24, Key = KEYS[1].Key }
		if hour >= a.Hour and hour < b.Hour then
			local t = (hour - a.Hour) / (b.Hour - a.Hour)
			local out = {}
			for name, value in a.Key do
				out[name] = lerp(value, b.Key[name], t)
			end
			return out
		end
	end
	return KEYS[1].Key
end

local function applyCurve(hour: number)
	local k = sample(hour)
	Lighting.Ambient = k.Ambient
	Lighting.OutdoorAmbient = k.Outdoor
	Lighting.Brightness = k.Brightness
	Lighting.ExposureCompensation = k.Exposure
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		atmosphere.Color = k.AtmColor
		atmosphere.Decay = k.AtmDecay
		atmosphere.Density = k.Density
	end
	local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
	if cc then
		cc.TintColor = k.Tint
		cc.Saturation = k.Saturation
		cc.Contrast = k.Contrast
	end
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
	if bloom then
		bloom.Intensity = k.Bloom
	end
end

local NIGHT_WINDOW_COLOR = Color3.fromRGB(255, 208, 140)
local night = false

local function applyLamp(bulb: Instance)
	local light = bulb:FindFirstChildWhichIsA("Light")
	if light then
		light.Enabled = night
	end
	if bulb:IsA("BasePart") then
		bulb.Material = if night then Enum.Material.Neon else Enum.Material.SmoothPlastic
	end
end

-- Ventanas que se iluminan de noche (las marca el generador de edificios)
local function applyWindow(window: Instance)
	if not window:IsA("BasePart") then
		return
	end
	window.Material = if night then Enum.Material.Neon else Enum.Material.Glass
	window.Color = if night then NIGHT_WINDOW_COLOR else (window:GetAttribute("DayColor") or window.Color)
end

local function setNight(on: boolean)
	night = on
	for _, bulb in CollectionService:GetTagged("StreetLamp") do
		applyLamp(bulb)
	end
	for _, window in CollectionService:GetTagged("NightWindow") do
		applyWindow(window)
	end
end

function WorldService.init()
	setupLighting()

	local day = 1
	workspace:SetAttribute("Day", day)
	local hoursPerSecond = 24 / (Config.DayLengthMinutes * 60)
	local lampsOn: boolean? = nil

	-- Lo que se construya después (casas de jugadores) respeta la hora actual
	CollectionService:GetInstanceAddedSignal("StreetLamp"):Connect(applyLamp)
	CollectionService:GetInstanceAddedSignal("NightWindow"):Connect(applyWindow)

	local sinceCurve = math.huge
	RunService.Heartbeat:Connect(function(dt)
		local previous = Lighting.ClockTime
		local clock = (previous + dt * hoursPerSecond) % 24
		Lighting.ClockTime = clock
		if clock < previous then
			day += 1
			workspace:SetAttribute("Day", day)
		end

		sinceCurve += dt
		if sinceCurve >= 0.5 then
			sinceCurve = 0
			applyCurve(clock)
		end

		local shouldBeOn = clock >= Config.LampsOnAt or clock < Config.LampsOffAt
		if shouldBeOn ~= lampsOn then
			lampsOn = shouldBeOn
			setNight(shouldBeOn)
		end
	end)
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="26">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">AssetLoader</string>
            <string name="Source"><![CDATA[-- AssetLoader: descarga al arrancar el servidor los packs gratuitos y oficiales de Synty
-- desde la Creator Store y los guarda en ServerStorage.AssetLibrary.
--
-- Usa AssetService:LoadAssetAsync (requiere AssetService.AllowInsertFreeAssets = true,
-- que ya viene activado en default.project.json). Si falla, prueba InsertService:LoadAsset.
-- Si tampoco funciona, el juego sigue con la ciudad hecha por código.

local AssetService = game:GetService("AssetService")
local InsertService = game:GetService("InsertService")
local ServerStorage = game:GetService("ServerStorage")

local AssetLibrary = require(script.Parent.Kit.AssetLibrary)

local AssetLoader = {}

AssetLoader.Packs = {
	{ Name = "SyntyCity", Id = 6933556508 }, -- Synty City Pack
	{ Name = "SyntyNature", Id = 6933438443 }, -- Synty Nature Pack
}

local function download(id: number): Instance?
	local ok, result = pcall(function()
		return (AssetService :: any):LoadAssetAsync(id)
	end)
	if ok and result then
		return result
	end
	warn(("[Assets] LoadAssetAsync(%d) falló: %s"):format(id, tostring(result)))
	ok, result = pcall(function()
		return InsertService:LoadAsset(id)
	end)
	if ok and result then
		return result
	end
	warn(("[Assets] InsertService:LoadAsset(%d) falló: %s"):format(id, tostring(result)))
	return nil
end

-- Devuelve cuántos packs hay disponibles (ya guardados en el archivo o descargados ahora)
function AssetLoader.load(): number
	local library = ServerStorage:FindFirstChild("AssetLibrary")
	if not library then
		library = Instance.new("Folder")
		library.Name = "AssetLibrary"
		library.Parent = ServerStorage
	end

	local available = 0
	for _, pack in AssetLoader.Packs do
		if library:FindFirstChild(pack.Name) then
			available += 1
		else
			local asset = download(pack.Id)
			if asset then
				asset.Name = pack.Name
				asset.Parent = library
				available += 1
			end
		end
	end

	-- Resumen en la ventana Output para saber qué modelos se están usando
	local summary = {}
	for kind in AssetLibrary.Catalog do
		table.insert(summary, ("%s=%d"):format(kind, #AssetLibrary.variants(kind)))
	end
	table.sort(summary)
	print(("[Assets] Packs disponibles: %d/%d · %s"):format(available, #AssetLoader.Packs, table.concat(summary, " ")))
	return available
end

return AssetLoader
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Builder</string>
            <string name="Source"><![CDATA[-- Builder: pequeñas herramientas para construir el mundo con Parts desde código.
-- Así el mapa entero vive en GitHub y no hace falta construirlo a mano en Studio.

local Builder = {}

-- Crea una pieza anclada. Acepta cualquier propiedad, más:
--   ClassName = "WedgePart" / "CornerWedgePart"... (por defecto "Part")
--   Tags = { "Tag1", ... }         -> etiquetas de CollectionService
--   Attributes = { Clave = valor } -> atributos
function Builder.part(props: { [string]: any }): BasePart
	local p = Instance.new(props.ClassName or "Part") :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "Parent" and key ~= "Tags" and key ~= "Attributes" and key ~= "ClassName" then
			(p :: any)[key] = value
		end
	end
	if props.Tags then
		for _, tag in props.Tags do
			p:AddTag(tag)
		end
	end
	if props.Attributes then
		for name, value in props.Attributes do
			p:SetAttribute(name, value)
		end
	end
	p.Parent = props.Parent
	return p
end

-- Pieza decorativa: sin colisiones ni consultas (más barata para el motor)
function Builder.decor(props: { [string]: any }): BasePart
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	return Builder.part(props)
end

-- CFrame en "position" mirando en horizontal hacia "direction".
-- (Usamos un giro en Y en vez de CFrame.lookAt: da el mismo resultado en Roblox
-- y también en Lune, que tiene un fallo con lookAt hacia +Z.)
function Builder.facing(position: Vector3, direction: Vector3): CFrame
	return CFrame.new(position) * CFrame.Angles(0, math.atan2(-direction.X, -direction.Z), 0)
end

function Builder.model(name: string, parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

-- Cartel con texto pegado a una cara de la pieza.
function Builder.sign(
	target: BasePart,
	text: string,
	face: Enum.NormalId?,
	textColor: Color3?,
	background: Color3?
): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = target

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = background or Color3.fromRGB(20, 24, 32)
	label.BackgroundTransparency = if background then 0 else 1
	label.TextColor3 = textColor or Color3.new(1, 1, 1)
	label.FontFace = Font.fromEnum(Enum.Font.GothamBlack)
	label.TextScaled = true
	label.Text = text
	label.Parent = gui

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.05, 0)
	padding.PaddingRight = UDim.new(0.05, 0)
	padding.PaddingTop = UDim.new(0.1, 0)
	padding.PaddingBottom = UDim.new(0.1, 0)
	padding.Parent = label

	return label
end

function Builder.prompt(parent: Instance, action: string, object: string?, hold: number?): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object or ""
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = parent
	return prompt
end

return Builder
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="29">
          <Properties>
            <string name="Name">Kit</string>
          </Properties>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">AssetLibrary</string>
              <string name="Source"><![CDATA[-- AssetLibrary: usa modelos importados (por ejemplo, los packs gratuitos de Synty
-- de la Creator Store) cuando existen, y si no, deja que el kit use su versión por código.
--
-- Los modelos viven en ServerStorage.AssetLibrary. En el repositorio, cada archivo
-- roblox/assets/*.rbxm se convierte en una carpeta dentro de AssetLibrary (lo hace Rojo).
--
-- Cada tipo de elemento ("Tree", "Car"…) tiene:
--   Patterns: trozos del nombre del modelo que lo identifican (sin mayúsculas)
--   Height:   altura objetivo en studs (se escala el modelo para encajar), opcional
--   Yaw:      giro extra si el "frente" del modelo no mira a -Z
-- También se puede forzar poniendo al modelo el atributo Asset = "Tree".

local Place = require(script.Parent.Place)

local AssetLibrary = {}

type Entry = { Patterns: { string }, Exclude: { string }?, Height: number?, Yaw: number? }

AssetLibrary.Catalog = {
	Tree = { Patterns = { "env_tree", "tree_" }, Exclude = { "palm", "pine", "dead", "stump", "log" }, Height = 16 },
	Pine = { Patterns = { "pine" }, Exclude = { "cone" }, Height = 18 },
	Palm = { Patterns = { "palm" }, Height = 20 },
	Bush = { Patterns = { "bush", "shrub" }, Height = 3.5 },
	Lamp = { Patterns = { "streetlight", "street_light", "lamppost", "lamp_post" }, Height = 15 },
	Bench = { Patterns = { "bench" }, Height = 3.4 },
	Bin = { Patterns = { "bin_", "trashcan", "trash_can", "rubbish" }, Height = 3 },
	Car = { Patterns = { "veh_car", "car_sedan", "car_hatch", "car_suv", "sedan", "hatchback" }, Exclude = { "wheel", "door", "police", "taxi" }, Height = 5.2 },
	TrafficLight = { Patterns = { "trafficlight", "traffic_light" }, Height = 15 },
	BusStop = { Patterns = { "busstop", "bus_stop", "bus_shelter" }, Height = 8.5 },
	Hydrant = { Patterns = { "hydrant" }, Height = 2.6 },
	Planter = { Patterns = { "planter", "flowerbed", "flower_bed" }, Height = 2.5 },
} :: { [string]: Entry }

local cache: { [string]: { Instance } } = {}

local function root(): Instance?
	local ok, storage = pcall(function()
		return game:GetService("ServerStorage")
	end)
	if not ok or not storage then
		return nil
	end
	return storage:FindFirstChild("AssetLibrary")
end

local function matches(name: string, entry: Entry): boolean
	local lower = string.lower(name)
	for _, bad in entry.Exclude or {} do
		if string.find(lower, bad, 1, true) then
			return false
		end
	end
	for _, pattern in entry.Patterns do
		if string.find(lower, pattern, 1, true) then
			return true
		end
	end
	return false
end

local function hasParts(instance: Instance): boolean
	if instance:IsA("BasePart") then
		return true
	end
	for _, d in instance:GetDescendants() do
		if d:IsA("BasePart") then
			return true
		end
	end
	return false
end

-- Plantillas disponibles para un tipo (se buscan una vez y se guardan)
function AssetLibrary.variants(kind: string): { Instance }
	if cache[kind] then
		return cache[kind]
	end
	local list = {}
	local entry = AssetLibrary.Catalog[kind]
	local library = root()
	if library and entry then
		for _, d in library:GetDescendants() do
			if (d:IsA("Model") or d:IsA("BasePart")) and hasParts(d) then
				local forced = d:GetAttribute("Asset")
				if forced == kind or (forced == nil and matches(d.Name, entry)) then
					-- Evitamos piezas sueltas que forman parte de un modelo ya elegido
					local parentChosen = false
					for _, chosen in list do
						if d:IsDescendantOf(chosen) then
							parentChosen = true
							break
						end
					end
					if not parentChosen then
						table.insert(list, d)
					end
				end
			end
		end
	end
	cache[kind] = list
	return list
end

function AssetLibrary.has(kind: string): boolean
	return #AssetLibrary.variants(kind) > 0
end

-- Crea una copia de un modelo del tipo pedido en "target" (base del modelo).
-- Devuelve nil si no hay ninguno: el que llama usa entonces su versión por código.
function AssetLibrary.spawn(kind: string, parent: Instance, target: CFrame, scale: number?): Instance?
	local variants = AssetLibrary.variants(kind)
	if #variants == 0 then
		return nil
	end
	local entry = AssetLibrary.Catalog[kind]
	local copy = variants[math.random(1, #variants)]:Clone()
	Place.sanitize(copy)
	local minV, maxV = Place.bounds(copy)
	local factor = scale or 1
	if entry.Height and maxV.Y > minV.Y then
		factor *= entry.Height / (maxV.Y - minV.Y)
	end
	Place.scale(copy, factor, Vector3.new((minV.X + maxV.X) / 2, minV.Y, (minV.Z + maxV.Z) / 2))
	Place.put(copy, target, entry.Yaw)
	copy.Parent = parent
	return copy
end

return AssetLibrary
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">Building</string>
              <string name="Source"><![CDATA[-- Building: generador de edificios con estilo (plantas, ventanas, balcones,
-- contraventanas, cornisas, tejados, escaparates, toldos y carteles).
--
-- Convención: el CFrame del edificio está en el centro de su huella, a nivel
-- del suelo (Y = 0), y su LookVector apunta hacia la calle (la fachada).
-- La planta baja es un interior hueco y jugable; las plantas superiores son fachada.

local Builder = require(script.Parent.Parent.Builder)
local Palette = require(script.Parent.Palette)

local Building = {}

Building.FLOOR_TOP = 1.0 -- altura del suelo interior (igual que la acera)
local FT = Building.FLOOR_TOP
local T = 1 -- grosor de pared
local NIGHT_WINDOW_CHANCE = 0.4

export type Spec = {
	Name: string,
	Parent: Instance,
	CFrame: CFrame,
	Width: number,
	Depth: number,
	Floors: number, -- plantas totales (incluida la baja)
	Style: string, -- clave de Palette.Styles
	GroundFloor: "Shop" | "Lobby" | "House" | "Closed",
	GroundHeight: number?,
	FloorHeight: number?,
	WallColor: Color3?,
	Interior: boolean?, -- planta baja con luz y cristales transparentes
	WindowFaces: { [string]: boolean }?, -- caras con ventanas (por defecto todas)
	Balconies: boolean?,
	Sign: string?,
	SignColor: Color3?,
	Awning: Color3?,
	FloorMaterial: Enum.Material?,
	FloorColor: Color3?,
	LightColor: Color3?,
}

type Opening = { X: number, W: number, Bottom: number, Top: number, Kind: string }

type Ctx = {
	Model: Model,
	Style: Palette.Style,
	WallColor: Color3,
	ShutterColor: Color3?,
	GroundGlassTransparency: number,
}

---------------------------------------------------------------------
-- Piezas básicas
---------------------------------------------------------------------

local function wallPiece(ctx: Ctx, face: CFrame, cx: number, cy: number, w: number, h: number)
	if w < 0.05 or h < 0.05 then
		return
	end
	Builder.part({
		Name = "Wall",
		Size = Vector3.new(w, h, T),
		CFrame = face * CFrame.new(cx, cy, T / 2),
		Color = ctx.WallColor,
		Material = ctx.Style.WallMaterial,
		Parent = ctx.Model,
	})
end

local function trim(ctx: Ctx, face: CFrame, size: Vector3, x: number, y: number, z: number)
	Builder.decor({
		Name = "Trim",
		Size = size,
		CFrame = face * CFrame.new(x, y, z),
		Color = ctx.Style.Trim,
		Material = ctx.Style.TrimMaterial,
		Parent = ctx.Model,
	})
end

local function glass(ctx: Ctx, face: CFrame, o: Opening, transparency: number, nightChance: number)
	local h = o.Top - o.Bottom
	local color = if transparency > 0 then Color3.fromRGB(176, 206, 220) else ctx.Style.Glass
	local pane = Builder.part({
		Name = "Glass",
		Size = Vector3.new(o.W, h, 0.2),
		CFrame = face * CFrame.new(o.X, o.Bottom + h / 2, T * 0.55),
		Color = color,
		Material = Enum.Material.Glass,
		Transparency = transparency,
		Reflectance = 0.15,
		Parent = ctx.Model,
	})
	if math.random() < nightChance then
		pane:AddTag("NightWindow")
		pane:SetAttribute("DayColor", color)
	end
end

local function fillOpening(ctx: Ctx, face: CFrame, o: Opening)
	local h = o.Top - o.Bottom
	local style = ctx.Style
	if o.Kind == "Window" or o.Kind == "Balcony" or o.Kind == "GroundWindow" then
		local isGround = o.Kind == "GroundWindow"
		glass(ctx, face, o, if isGround then ctx.GroundGlassTransparency else 0, if isGround then 0 else NIGHT_WINDOW_CHANCE)
		if o.Kind ~= "Balcony" then
			trim(ctx, face, Vector3.new(o.W + 0.6, 0.3, 0.7), o.X, o.Bottom - 0.15, -0.15) -- alféizar
		end
		if style.Lintels then
			trim(ctx, face, Vector3.new(o.W + 0.8, 0.5, 0.35), o.X, o.Top + 0.25, -0.1) -- dintel
		end
		if ctx.ShutterColor then
			for _, side in { -1, 1 } do
				Builder.decor({
					Name = "Shutter",
					Size = Vector3.new(o.W / 2, h, 0.15),
					CFrame = face * CFrame.new(o.X + side * (o.W * 0.75 + 0.15), o.Bottom + h / 2, -0.08),
					Color = ctx.ShutterColor,
					Material = Enum.Material.Wood,
					Parent = ctx.Model,
				})
			end
		end
		if o.Kind == "Balcony" and style.Balconies ~= "None" then
			local bw = o.W + 2.4
			Builder.part({
				Name = "BalconySlab",
				Size = Vector3.new(bw, 0.4, 2.2),
				CFrame = face * CFrame.new(o.X, o.Bottom - 0.2, -1.1),
				Color = style.Trim,
				Material = style.TrimMaterial,
				Parent = ctx.Model,
			})
			local iron = style.Balconies == "Iron"
			Builder.decor({
				Name = "Railing",
				Size = Vector3.new(bw, 3, 0.1),
				CFrame = face * CFrame.new(o.X, o.Bottom + 1.5, -2.1),
				Color = if iron then Color3.fromRGB(40, 40, 44) else Color3.fromRGB(180, 210, 224),
				Material = if iron then Enum.Material.Metal else Enum.Material.Glass,
				Transparency = if iron then 0.6 else 0.6,
				Parent = ctx.Model,
			})
			Builder.decor({
				Name = "BottomRail",
				Size = Vector3.new(bw, 0.2, 0.2),
				CFrame = face * CFrame.new(o.X, o.Bottom + 0.3, -2.1),
				Color = Color3.fromRGB(34, 34, 38),
				Material = Enum.Material.Metal,
				Parent = ctx.Model,
			})
			Builder.decor({
				Name = "Handrail",
				Size = Vector3.new(bw + 0.2, 0.2, 0.25),
				CFrame = face * CFrame.new(o.X, o.Bottom + 3.05, -2.1),
				Color = Color3.fromRGB(34, 34, 38),
				Material = Enum.Material.Metal,
				Parent = ctx.Model,
			})
		end
	elseif o.Kind == "Shop" then
		-- Sin interior jugable: cristal reflectante en vez de ver una sala vacía
		-- Los escaparates se iluminan de noche (comercios abiertos)
		glass(ctx, face, o, if ctx.GroundGlassTransparency > 0 then 0.55 else 0, 1)
		trim(ctx, face, Vector3.new(o.W, 0.3, T + 0.3), o.X, o.Bottom - 0.15, T / 2 - 0.15)
	elseif o.Kind == "Door" or o.Kind == "FakeDoor" then
		for _, side in { -1, 1 } do
			trim(ctx, face, Vector3.new(0.5, h + 0.5, T + 0.4), o.X + side * (o.W / 2 + 0.25), o.Bottom + (h + 0.5) / 2, T / 2)
		end
		trim(ctx, face, Vector3.new(o.W + 1, 0.5, T + 0.4), o.X, o.Top + 0.25, T / 2)
		if o.Kind == "FakeDoor" then
			Builder.part({
				Name = "DoorPanel",
				Size = Vector3.new(o.W, h, 0.3),
				CFrame = face * CFrame.new(o.X, o.Bottom + h / 2, T * 0.6),
				Color = Color3.fromRGB(92, 64, 46),
				Material = Enum.Material.Wood,
				Parent = ctx.Model,
			})
		end
	end
end

-- Pared de una cara (tramo de altura h desde y0) con huecos rectangulares.
local function wallWithOpenings(ctx: Ctx, face: CFrame, L: number, y0: number, h: number, openings: { Opening })
	table.sort(openings, function(a, b)
		return a.X < b.X
	end)
	local cursor = -L / 2
	for _, o in openings do
		local left = o.X - o.W / 2
		wallPiece(ctx, face, (cursor + left) / 2, y0 + h / 2, left - cursor, h)
		wallPiece(ctx, face, o.X, (y0 + o.Bottom) / 2, o.W, o.Bottom - y0)
		wallPiece(ctx, face, o.X, (o.Top + y0 + h) / 2, o.W, y0 + h - o.Top)
		fillOpening(ctx, face, o)
		cursor = o.X + o.W / 2
	end
	wallPiece(ctx, face, (cursor + L / 2) / 2, y0 + h / 2, L / 2 - cursor, h)
end

-- Posiciones X de columnas de ventanas repartidas en una fachada
local function columns(L: number, bay: number, margin: number): { number }
	local n = math.floor((L - 2 * margin) / bay)
	local xs = {}
	for i = 0, n - 1 do
		table.insert(xs, -(n - 1) * bay / 2 + i * bay)
	end
	return xs
end

-- Ventanas a ambos lados de una puerta central
local function columnsAroundDoor(L: number, doorW: number, winW: number, bay: number): { number }
	local xs = {}
	local x = doorW / 2 + 2 + winW / 2
	while x + winW / 2 + 2 <= L / 2 do
		table.insert(xs, -x)
		table.insert(xs, x)
		x += bay
	end
	return xs
end

---------------------------------------------------------------------
-- Edificio completo
---------------------------------------------------------------------

function Building.build(spec: Spec): (Model, (number, number, number) -> CFrame)
	local style: Palette.Style = Palette.Styles[spec.Style] or Palette.Styles.Clasico
	local model = Builder.model(spec.Name, spec.Parent)
	local O = spec.CFrame
	local W, D = spec.Width, spec.Depth
	local floors = math.max(1, spec.Floors)
	local G = spec.GroundHeight or (if spec.GroundFloor == "Shop" then 15 elseif spec.GroundFloor == "House" then 11 else 13)
	local FH = spec.FloorHeight or (if spec.GroundFloor == "House" then 10 else 12)
	local Y1 = FT + G -- techo de la planta baja
	local top = Y1 + (floors - 1) * FH
	local interior = spec.Interior ~= false and spec.GroundFloor ~= "Closed"
	local windowFaces = spec.WindowFaces or { Front = true, Back = true, Left = true, Right = true }

	local ctx: Ctx = {
		Model = model,
		Style = style,
		WallColor = spec.WallColor or Palette.pick(style.Wall),
		ShutterColor = if style.Shutters then Palette.pick(style.Shutters) else nil,
		GroundGlassTransparency = if interior then 0.4 else 0,
	}

	local function at(x: number, y: number, z: number): CFrame
		return O * CFrame.new(x, FT + y, z)
	end

	local faces = {
		{ Name = "Front", CF = O * CFrame.new(0, 0, -D / 2), L = W, Full = W },
		{ Name = "Back", CF = O * CFrame.new(0, 0, D / 2) * CFrame.Angles(0, math.pi, 0), L = W, Full = W },
		{ Name = "Left", CF = O * CFrame.new(-W / 2, 0, 0) * CFrame.Angles(0, math.pi / 2, 0), L = D - 2 * T, Full = D },
		{ Name = "Right", CF = O * CFrame.new(W / 2, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), L = D - 2 * T, Full = D },
	}

	-- Suelo interior
	Builder.part({
		Name = "Floor",
		Size = Vector3.new(W - 2 * T, FT, D - 2 * T),
		CFrame = O * CFrame.new(0, FT / 2, 0),
		Color = spec.FloorColor or Color3.fromRGB(176, 140, 104),
		Material = spec.FloorMaterial or Enum.Material.WoodPlanks,
		Parent = model,
	})

	for _, face in faces do
		local L = face.L
		local hasWindows = windowFaces[face.Name] == true
		local isFront = face.Name == "Front"

		-- Zócalo de piedra
		trim(ctx, face.CF, Vector3.new(L, FT, 0.3), 0, FT / 2, -0.15)

		-- PLANTA BAJA
		local ground: { Opening } = {}
		if isFront then
			local kind = spec.GroundFloor
			if kind == "Shop" then
				table.insert(ground, { X = 0, W = 8, Bottom = FT, Top = FT + 10, Kind = "Door" })
				local winW = L / 2 - 8
				if winW >= 4 then
					local wx = 4 + 2 + winW / 2
					for _, side in { -1, 1 } do
						table.insert(ground, { X = side * wx, W = winW, Bottom = FT + 1.2, Top = FT + G - 3.5, Kind = "Shop" })
					end
				end
			else
				local doorW = if kind == "House" then 5 else 8
				local doorH = if kind == "House" then 8 else 10
				table.insert(ground, {
					X = 0,
					W = doorW,
					Bottom = FT,
					Top = FT + doorH,
					Kind = if kind == "Closed" then "FakeDoor" else "Door",
				})
				for _, x in columnsAroundDoor(L, doorW, style.WindowW, style.Bay) do
					table.insert(ground, { X = x, W = style.WindowW, Bottom = FT + 3, Top = FT + 3 + math.min(style.WindowH, G - 4.5), Kind = "GroundWindow" })
				end
			end
		elseif hasWindows then
			for _, x in columns(L, style.Bay, 2.5) do
				table.insert(ground, { X = x, W = style.WindowW, Bottom = FT + 3, Top = FT + 3 + math.min(style.WindowH, G - 4.5), Kind = "GroundWindow" })
			end
		end

		if not hasWindows and not isFront then
			-- Cara ciega: una sola pieza de pared de arriba abajo
			wallPiece(ctx, face.CF, 0, top / 2, L, top)
		else
			wallWithOpenings(ctx, face.CF, L, 0, Y1, ground)

			-- PLANTAS SUPERIORES
			local wantBalconies = isFront and (if spec.Balconies ~= nil then spec.Balconies else style.Balconies ~= "None")
			for f = 1, floors - 1 do
				local yb = Y1 + (f - 1) * FH
				local openings: { Opening } = {}
				if hasWindows or isFront then
					for _, x in columns(L, style.Bay, 2.5) do
						local balcony = wantBalconies and (spec.Style ~= "Popular" or math.random() < 0.6)
						local winH = if balcony then math.min(style.WindowH + 1.5, FH - 2) else math.min(style.WindowH, FH - 4.5)
						local bottom = if balcony then yb + 0.4 else yb + 3
						table.insert(openings, { X = x, W = style.WindowW, Bottom = bottom, Top = bottom + winH, Kind = if balcony then "Balcony" else "Window" })
					end
				end
				wallWithOpenings(ctx, face.CF, L, yb, FH, openings)
				-- Imposta (línea entre plantas)
				trim(ctx, face.CF, Vector3.new(face.Full + 0.4, 0.6, 0.4), 0, yb, -0.2)
			end
		end
	end

	-- Techo de la planta baja y luz interior
	Builder.part({
		Name = "Ceiling",
		Size = Vector3.new(W - 2 * T, 1, D - 2 * T),
		CFrame = O * CFrame.new(0, Y1 - 0.5, 0),
		Color = Color3.fromRGB(244, 242, 236),
		Material = Enum.Material.Plaster,
		Parent = model,
	})
	if interior then
		local lamp = Builder.decor({
			Name = "CeilingLamp",
			Size = Vector3.new(3, 0.3, 3),
			CFrame = O * CFrame.new(0, Y1 - 1.15, 0),
			Color = Color3.fromRGB(255, 244, 222),
			Material = Enum.Material.Neon,
			Parent = model,
		})
		local light = Instance.new("PointLight")
		light.Range = math.min(60, math.max(W, D) * 0.8)
		light.Brightness = 1.1
		light.Color = spec.LightColor or Color3.fromRGB(255, 232, 200)
		light.Shadows = false
		light.Parent = lamp
	end

	-- CUBIERTA
	if style.Roof == "Gable" then
		local o = 1.2
		local rh = math.max(4, D * 0.28)
		local depth = D / 2 + o
		for _, side in { -1, 1 } do
			local cf = O * CFrame.new(0, top + rh / 2, side * depth / 2) * (if side > 0 then CFrame.Angles(0, math.pi, 0) else CFrame.new())
			Builder.part({
				ClassName = "WedgePart",
				Name = "Roof",
				Size = Vector3.new(W + 2 * o, rh, depth),
				CFrame = cf,
				Color = style.RoofColor or Color3.fromRGB(176, 86, 56),
				Material = style.RoofMaterial or Enum.Material.ClayRoofTiles,
				Parent = model,
			})
			-- Hastiales (triángulos laterales del color de la pared)
			for _, xs in { -1, 1 } do
				Builder.decor({
					ClassName = "WedgePart",
					Name = "Gable",
					Size = Vector3.new(0.1, rh, depth),
					CFrame = cf * CFrame.new(xs * (W / 2 + o + 0.05), 0, 0),
					Color = ctx.WallColor,
					Material = style.WallMaterial,
					Parent = model,
				})
			end
		end
		Builder.part({
			Name = "Chimney",
			Size = Vector3.new(2, rh + 2, 2),
			CFrame = O * CFrame.new(W / 4, top + (rh + 2) / 2, D / 6),
			Color = ctx.WallColor,
			Material = style.WallMaterial,
			Parent = model,
		})
	else
		Builder.part({
			Name = "Roof",
			Size = Vector3.new(W, 1, D),
			CFrame = O * CFrame.new(0, top + 0.5, 0),
			Color = Color3.fromRGB(130, 128, 124),
			Material = Enum.Material.Concrete,
			Parent = model,
		})
		-- Cornisa / pretil
		for _, face in faces do
			local length = if face.Name == "Front" or face.Name == "Back" then W + 1.8 else D - 0.6
			trim(ctx, face.CF, Vector3.new(length, 2.4, 1.2), 0, top + 1.2, -0.3)
		end
		-- Máquinas en la azotea
		if W > 16 and D > 16 then
			for i = 1, math.random(1, 3) do
				Builder.decor({
					Name = "RoofUnit",
					Size = Vector3.new(3, 2, 2.5),
					CFrame = O * CFrame.new((i - 2) * 5, top + 2, D / 4),
					Color = Color3.fromRGB(190, 192, 196),
					Material = Enum.Material.Metal,
					Parent = model,
				})
			end
		end
	end

	-- Cartel y toldos (comercios)
	if spec.Sign then
		local signPart = Builder.decor({
			Name = "Sign",
			Size = Vector3.new(math.min(W * 0.6, 28), 2.6, 0.3),
			CFrame = O * CFrame.new(0, Y1 - 1.8, -D / 2 - 0.15),
			Color = spec.SignColor or Color3.fromRGB(30, 34, 46),
			Parent = model,
		})
		Builder.sign(signPart, spec.Sign, Enum.NormalId.Front)
	end
	if spec.Awning and spec.GroundFloor == "Shop" then
		local winW = W / 2 - 8
		if winW >= 4 then
			local wx = 6 + winW / 2
			for _, side in { -1, 1 } do
				Builder.decor({
					Name = "Awning",
					Size = Vector3.new(winW + 1, 0.2, 3.2),
					CFrame = O * CFrame.new(side * wx, FT + G - 4.0, -D / 2 - 1.5) * CFrame.Angles(math.rad(-18), 0, 0),
					Color = spec.Awning,
					Material = Enum.Material.Fabric,
					Parent = model,
				})
			end
		end
	end

	model.PrimaryPart = model:FindFirstChild("Floor") :: BasePart
	return model, at
end

return Building
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">Nature</string>
              <string name="Source"><![CDATA[-- Nature: árboles, palmeras, cipreses, arbustos, setos y parterres de flores.

local Builder = require(script.Parent.Parent.Builder)
local Palette = require(script.Parent.Palette)
local AssetLibrary = require(script.Parent.AssetLibrary)

local Nature = {}

local C = Palette.Nature

local function leafColor(): Color3
	return Palette.pick(C.Leaves)
end

-- Árbol de hoja ancha: tronco + copa de varias esferas
function Nature.tree(parent: Instance, base: Vector3, scale: number?)
	local asset = AssetLibrary.spawn("Tree", parent, CFrame.new(base) * CFrame.Angles(0, math.random() * math.pi * 2, 0), scale)
	if asset then
		return asset
	end
	local s = scale or (0.85 + math.random() * 0.4)
	local m = Builder.model("Tree", parent)
	local height = 9 * s
	Builder.part({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, 1.3 * s, 1.3 * s),
		CFrame = CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = C.Trunk,
		Material = Enum.Material.Wood,
		Parent = m,
	})
	local crownY = base.Y + height + 1.5 * s
	local blobs = {
		{ Vector3.new(0, 1.5, 0), 9 },
		{ Vector3.new(2.6, 0, 1.2), 7 },
		{ Vector3.new(-2.4, 0.3, -1.4), 7 },
		{ Vector3.new(0.8, -0.6, -2.6), 6.5 },
		{ Vector3.new(-1.2, -0.4, 2.6), 6.5 },
	}
	local color = leafColor()
	for _, b in blobs do
		local d = b[2] * s
		Builder.decor({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(d, d, d),
			CFrame = CFrame.new(Vector3.new(base.X, crownY, base.Z) + b[1] * s),
			Color = color:Lerp(leafColor(), 0.4),
			Material = Enum.Material.LeafyGrass,
			Parent = m,
		})
	end
	return m
end

-- Ciprés mediterráneo: alto y estrecho
function Nature.cypress(parent: Instance, base: Vector3)
	local asset = AssetLibrary.spawn("Pine", parent, CFrame.new(base) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	if asset then
		return asset
	end
	local m = Builder.model("Cypress", parent)
	local s = 0.9 + math.random() * 0.3
	Builder.part({ Name = "Trunk", Size = Vector3.new(0.8, 2, 0.8), CFrame = CFrame.new(base + Vector3.new(0, 1, 0)), Color = C.Trunk, Material = Enum.Material.Wood, Parent = m })
	local color = Color3.fromRGB(46, 84, 48)
	for i, d in { 4.2, 3.9, 3.4, 2.7, 1.8 } do
		Builder.decor({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(d, d, d) * s,
			CFrame = CFrame.new(base + Vector3.new(0, (1.6 + i * 2.4) * s, 0)),
			Color = color,
			Material = Enum.Material.LeafyGrass,
			Parent = m,
		})
	end
	return m
end

-- Palmera: tronco curvado en segmentos + hojas colgantes
function Nature.palm(parent: Instance, base: Vector3)
	local asset = AssetLibrary.spawn("Palm", parent, CFrame.new(base) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	if asset then
		return asset
	end
	local m = Builder.model("Palm", parent)
	local lean = math.rad(math.random(-8, 8))
	local yaw = math.rad(math.random(0, 359))
	local cf = CFrame.new(base) * CFrame.Angles(0, yaw, 0)
	for i = 1, 5 do
		local seg = 3.2
		cf = cf * CFrame.Angles(lean, 0, 0)
		Builder.part({
			Name = "Trunk",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(seg + 0.2, 1.1 - i * 0.08, 1.1 - i * 0.08),
			CFrame = cf * CFrame.new(0, seg / 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color = C.PalmTrunk,
			Material = Enum.Material.Wood,
			Parent = m,
		})
		cf = cf * CFrame.new(0, seg, 0)
	end
	local top = cf.Position
	for i = 1, 8 do
		local leaf = CFrame.new(top) * CFrame.Angles(0, math.rad(i * 45 + math.random(-10, 10)), 0) * CFrame.Angles(math.rad(-28), 0, 0) * CFrame.new(0, 0, -3.8)
		Builder.decor({
			Name = "Frond",
			Size = Vector3.new(1.8, 0.15, 8),
			CFrame = leaf,
			Color = Color3.fromRGB(78, 136, 60):Lerp(Color3.fromRGB(110, 150, 70), math.random()),
			Material = Enum.Material.Grass,
			Parent = m,
		})
	end
	for i = 1, 3 do
		Builder.decor({
			Name = "Coconut",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.8, 0.8, 0.8),
			CFrame = CFrame.new(top + Vector3.new(math.cos(i * 2.1) * 0.6, -0.6, math.sin(i * 2.1) * 0.6)),
			Color = Color3.fromRGB(110, 84, 50),
			Parent = m,
		})
	end
	return m
end

function Nature.bush(parent: Instance, base: Vector3, size: number?)
	if AssetLibrary.spawn("Bush", parent, CFrame.new(base) * CFrame.Angles(0, math.random() * math.pi * 2, 0)) then
		return
	end
	local d = size or (2.5 + math.random() * 1.5)
	Builder.decor({
		Name = "Bush",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(d, d * 0.8, d),
		CFrame = CFrame.new(base + Vector3.new(0, d * 0.3, 0)),
		Color = leafColor():Lerp(C.Hedge, 0.5),
		Material = Enum.Material.LeafyGrass,
		Parent = parent,
	})
end

-- Seto recto entre dos puntos (a nivel del suelo)
function Nature.hedge(parent: Instance, from: Vector3, to: Vector3, height: number?)
	local h = height or 3
	local length = (to - from).Magnitude
	Builder.part({
		Name = "Hedge",
		Size = Vector3.new(1.6, h, length),
		CFrame = Builder.facing((from + to) / 2, to - from) * CFrame.new(0, h / 2, 0),
		Color = C.Hedge,
		Material = Enum.Material.LeafyGrass,
		Parent = parent,
	})
end

-- Parterre: jardinera de piedra con flores
function Nature.flowerBed(parent: Instance, cf: CFrame, width: number, depth: number)
	local m = Builder.model("FlowerBed", parent)
	Builder.part({ Name = "Border", Size = Vector3.new(width, 1.2, depth), CFrame = cf * CFrame.new(0, 0.6, 0), Color = Color3.fromRGB(206, 196, 178), Material = Enum.Material.Limestone, Parent = m })
	Builder.decor({ Name = "Soil", Size = Vector3.new(width - 0.8, 0.2, depth - 0.8), CFrame = cf * CFrame.new(0, 1.25, 0), Color = Color3.fromRGB(92, 66, 46), Material = Enum.Material.Ground, Parent = m })
	local count = math.floor(width * depth / 5)
	for _ = 1, count do
		local x = (math.random() - 0.5) * (width - 1.4)
		local z = (math.random() - 0.5) * (depth - 1.4)
		Builder.decor({
			Name = "Flower",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.9, 0.9, 0.9),
			CFrame = cf * CFrame.new(x, 1.7, z),
			Color = Palette.pick(C.Flowers),
			Material = Enum.Material.SmoothPlastic,
			Parent = m,
		})
	end
	return m
end

return Nature
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">Palette</string>
              <string name="Source"><![CDATA[-- Palette: colores, materiales y estilos arquitectónicos de Valmar.
-- Cambiar un color aquí lo cambia en toda la ciudad.

local Palette = {}

local rgb = Color3.fromRGB

Palette.Ground = {
	Grass = rgb(98, 146, 70),
	Lawn = rgb(106, 158, 76),
	Asphalt = rgb(52, 54, 58),
	Sidewalk = rgb(196, 192, 184),
	Curb = rgb(214, 211, 204),
	Marking = rgb(236, 236, 230),
	MarkingYellow = rgb(232, 196, 70),
	Plaza = rgb(214, 202, 182),
}

Palette.Nature = {
	Trunk = rgb(104, 78, 56),
	PalmTrunk = rgb(150, 122, 88),
	Leaves = { rgb(70, 124, 58), rgb(84, 138, 62), rgb(62, 110, 54), rgb(96, 146, 66) },
	Hedge = rgb(58, 104, 50),
	Flowers = { rgb(226, 72, 92), rgb(246, 196, 60), rgb(240, 240, 240), rgb(170, 90, 200), rgb(250, 130, 60) },
}

Palette.Street = {
	Metal = rgb(58, 62, 68),
	LampLight = rgb(255, 214, 160),
	Wood = rgb(132, 96, 66),
	Glass = rgb(160, 196, 214),
}

Palette.CarColors = {
	rgb(235, 235, 235), rgb(30, 30, 34), rgb(150, 155, 162), rgb(170, 30, 36),
	rgb(34, 70, 140), rgb(200, 190, 170), rgb(60, 90, 70), rgb(240, 200, 60),
}

-- Estilos de edificio. Wall: lista de colores posibles (se elige uno al azar).
export type Style = {
	Wall: { Color3 },
	WallMaterial: Enum.Material,
	Trim: Color3,
	TrimMaterial: Enum.Material,
	Glass: Color3,
	Bay: number, -- separación entre ventanas
	WindowW: number,
	WindowH: number,
	Lintels: boolean,
	Shutters: { Color3 }?,
	Balconies: "None" | "Iron" | "Glass",
	Roof: "Flat" | "Gable",
	RoofColor: Color3?,
	RoofMaterial: Enum.Material?,
}

Palette.Styles = {
	-- Edificios clásicos del centro: piedra clara, balcones de hierro
	Clasico = {
		Wall = { rgb(236, 226, 206), rgb(226, 214, 190), rgb(240, 234, 222), rgb(214, 196, 170) },
		WallMaterial = Enum.Material.Plaster,
		Trim = rgb(246, 242, 232),
		TrimMaterial = Enum.Material.Limestone,
		Glass = rgb(52, 70, 84),
		Bay = 8,
		WindowW = 3.6,
		WindowH = 7,
		Lintels = true,
		Shutters = nil,
		Balconies = "Iron",
		Roof = "Flat",
	},
	-- Oficinas y comercios modernos: hormigón claro y ventanales
	Moderno = {
		Wall = { rgb(222, 222, 220), rgb(200, 202, 204), rgb(180, 184, 188) },
		WallMaterial = Enum.Material.Concrete,
		Trim = rgb(90, 94, 100),
		TrimMaterial = Enum.Material.Metal,
		Glass = rgb(66, 96, 112),
		Bay = 8,
		WindowW = 6.4,
		WindowH = 8,
		Lintels = false,
		Shutters = nil,
		Balconies = "Glass",
		Roof = "Flat",
	},
	-- Barrio popular mediterráneo: colores cálidos y contraventanas
	Popular = {
		Wall = { rgb(212, 132, 96), rgb(224, 176, 96), rgb(232, 160, 128), rgb(236, 214, 150), rgb(170, 196, 212), rgb(226, 196, 170) },
		WallMaterial = Enum.Material.Plaster,
		Trim = rgb(244, 238, 226),
		TrimMaterial = Enum.Material.Plaster,
		Glass = rgb(56, 70, 80),
		Bay = 8,
		WindowW = 3.4,
		WindowH = 6.5,
		Lintels = false,
		Shutters = { rgb(70, 112, 80), rgb(60, 92, 134), rgb(112, 78, 52) },
		Balconies = "Iron",
		Roof = "Flat",
	},
	-- Casas: blanco o crema con tejado de teja
	Casa = {
		Wall = { rgb(244, 240, 232), rgb(240, 226, 200), rgb(230, 190, 160), rgb(236, 228, 210) },
		WallMaterial = Enum.Material.Plaster,
		Trim = rgb(250, 248, 244),
		TrimMaterial = Enum.Material.Plaster,
		Glass = rgb(60, 78, 90),
		Bay = 8,
		WindowW = 4,
		WindowH = 5.5,
		Lintels = false,
		Shutters = { rgb(70, 112, 80), rgb(60, 92, 134), rgb(120, 84, 56) },
		Balconies = "None",
		Roof = "Gable",
		RoofColor = rgb(176, 86, 56),
		RoofMaterial = Enum.Material.ClayRoofTiles,
	},
}

function Palette.pick<T>(list: { T }): T
	return list[math.random(1, #list)]
end

return Palette
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">Place</string>
              <string name="Source"><![CDATA[-- Place: utilidades para colocar, escalar y limpiar modelos importados.
-- Se implementan a mano (sin PivotTo/ScaleTo) para que funcionen igual en Roblox
-- y en Lune, que es la herramienta que mete la ciudad dentro del archivo del juego.

local Place = {}

local function parts(model: Instance): { BasePart }
	local list = {}
	if model:IsA("BasePart") then
		table.insert(list, model)
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(list, d)
		end
	end
	return list
end

-- Caja envolvente alineada con los ejes del mundo: devuelve mínimo y máximo
function Place.bounds(model: Instance): (Vector3, Vector3)
	local minV = Vector3.new(math.huge, math.huge, math.huge)
	local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)
	for _, p in parts(model) do
		local cf, half = p.CFrame, p.Size / 2
		for _, sx in { -1, 1 } do
			for _, sy in { -1, 1 } do
				for _, sz in { -1, 1 } do
					local corner = (cf * CFrame.new(half.X * sx, half.Y * sy, half.Z * sz)).Position
					minV = Vector3.new(math.min(minV.X, corner.X), math.min(minV.Y, corner.Y), math.min(minV.Z, corner.Z))
					maxV = Vector3.new(math.max(maxV.X, corner.X), math.max(maxV.Y, corner.Y), math.max(maxV.Z, corner.Z))
				end
			end
		end
	end
	return minV, maxV
end

-- Quita scripts (seguridad), ancla todo y desactiva colisiones costosas en detalles pequeños
function Place.sanitize(model: Instance)
	for _, d in model:GetDescendants() do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanTouch = false
			if d.Size.Magnitude < 2 then
				d.CanCollide = false
				d.CanQuery = false
			end
		end
	end
end

-- Escala un modelo alrededor de un punto
function Place.scale(model: Instance, factor: number, around: Vector3)
	if math.abs(factor - 1) < 1e-3 then
		return
	end
	for _, p in parts(model) do
		local cf = p.CFrame
		local offset = cf.Position - around
		p.Size *= factor
		p.CFrame = CFrame.new(around + offset * factor) * (cf - cf.Position)
	end
	for _, d in model:GetDescendants() do
		if d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
			d.Range *= factor
		end
	end
end

-- Mueve el modelo para que el centro de su base quede en "target" (orientado como target).
-- yaw: giro extra (radianes) para corregir modelos cuyo "frente" no mira a -Z.
function Place.put(model: Instance, target: CFrame, yaw: number?)
	local minV, maxV = Place.bounds(model)
	local base = CFrame.new((minV.X + maxV.X) / 2, minV.Y, (minV.Z + maxV.Z) / 2)
	local transform = target * CFrame.Angles(0, yaw or 0, 0) * base:Inverse()
	for _, p in parts(model) do
		p.CFrame = transform * p.CFrame
	end
end

-- Tamaño del modelo (ancho X, alto Y, fondo Z) según su caja envolvente
function Place.size(model: Instance): Vector3
	local minV, maxV = Place.bounds(model)
	return maxV - minV
end

return Place
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">Props</string>
              <string name="Source"><![CDATA[-- Props: mobiliario urbano y coches aparcados.
-- Todos reciben un CFrame a nivel del suelo que mira (LookVector) hacia donde "mira" el objeto.

local Builder = require(script.Parent.Parent.Builder)
local Palette = require(script.Parent.Palette)
local AssetLibrary = require(script.Parent.AssetLibrary)
local Place = require(script.Parent.Place)

-- Luz invisible en lo alto de una farola importada (la enciende WorldService de noche)
local function addLampLight(model: Instance)
	local minV, maxV = Place.bounds(model)
	local lens = Builder.decor({
		Name = "Lens",
		Size = Vector3.new(0.4, 0.1, 0.4),
		CFrame = CFrame.new((minV.X + maxV.X) / 2, maxV.Y - 0.8, (minV.Z + maxV.Z) / 2),
		Transparency = 1,
		Tags = { "StreetLamp" },
		Parent = model,
	})
	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Bottom
	light.Angle = 110
	light.Range = 36
	light.Brightness = 2.2
	light.Color = Palette.Street.LampLight
	light.Shadows = false
	light.Enabled = false
	light.Parent = lens
end

local Props = {}

local S = Palette.Street

-- Farola con brazo. El CFrame mira hacia la calzada (el brazo sale hacia delante).
function Props.lamp(parent: Instance, cf: CFrame)
	local asset = AssetLibrary.spawn("Lamp", parent, cf)
	if asset then
		addLampLight(asset)
		return asset
	end
	local m = Builder.model("StreetLamp", parent)
	Builder.part({ Name = "Base", Size = Vector3.new(1.2, 1, 1.2), CFrame = cf * CFrame.new(0, 0.5, 0), Color = S.Metal, Material = Enum.Material.Metal, Parent = m })
	Builder.part({
		Name = "Pole",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(14, 0.5, 0.5),
		CFrame = cf * CFrame.new(0, 7.5, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = S.Metal,
		Material = Enum.Material.Metal,
		Parent = m,
	})
	Builder.decor({ Name = "Arm", Size = Vector3.new(0.3, 0.3, 3.4), CFrame = cf * CFrame.new(0, 14.2, -1.5), Color = S.Metal, Material = Enum.Material.Metal, Parent = m })
	Builder.decor({ Name = "Head", Size = Vector3.new(1.4, 0.5, 2.4), CFrame = cf * CFrame.new(0, 14.2, -3.4), Color = S.Metal, Material = Enum.Material.Metal, Parent = m })
	local lens = Builder.decor({
		Name = "Lens",
		Size = Vector3.new(1.1, 0.12, 2),
		CFrame = cf * CFrame.new(0, 13.9, -3.4),
		Color = S.LampLight,
		Material = Enum.Material.SmoothPlastic,
		Tags = { "StreetLamp" },
		Parent = m,
	})
	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Bottom
	light.Angle = 110
	light.Range = 36
	light.Brightness = 2.2
	light.Color = S.LampLight
	light.Shadows = false
	light.Enabled = false
	light.Parent = lens
	return m
end

-- Semáforo: poste en la esquina con brazo sobre la calzada (hacia delante)
function Props.trafficLight(parent: Instance, cf: CFrame, armLength: number)
	local asset = AssetLibrary.spawn("TrafficLight", parent, cf)
	if asset then
		return asset
	end
	local m = Builder.model("TrafficLight", parent)
	Builder.part({
		Name = "Pole",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(15, 0.6, 0.6),
		CFrame = cf * CFrame.new(0, 7.5, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = S.Metal,
		Material = Enum.Material.Metal,
		Parent = m,
	})
	Builder.decor({ Name = "Arm", Size = Vector3.new(0.4, 0.4, armLength), CFrame = cf * CFrame.new(0, 14.6, -armLength / 2), Color = S.Metal, Material = Enum.Material.Metal, Parent = m })
	local box = cf * CFrame.new(0, 13, -armLength + 1)
	Builder.decor({ Name = "Box", Size = Vector3.new(1.4, 3.6, 1.2), CFrame = box, Color = Color3.fromRGB(28, 30, 32), Parent = m })
	local lights = {
		{ 1.1, Color3.fromRGB(90, 20, 20), Enum.Material.SmoothPlastic },
		{ 0, Color3.fromRGB(90, 70, 20), Enum.Material.SmoothPlastic },
		{ -1.1, Color3.fromRGB(60, 255, 120), Enum.Material.Neon },
	}
	for _, l in lights do
		-- Luces a ambos lados de la caja, mirando a lo largo de la calzada
		for _, side in { -1, 1 } do
			Builder.decor({
				Name = "Light",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.2, 0.9, 0.9),
				CFrame = box * CFrame.new(side * 0.72, l[1], 0),
				Color = l[2],
				Material = l[3],
				Parent = m,
			})
		end
	end
	return m
end

function Props.bench(parent: Instance, cf: CFrame)
	local asset = AssetLibrary.spawn("Bench", parent, cf)
	if asset then
		return asset
	end
	local m = Builder.model("Bench", parent)
	Builder.part({ Name = "Seat", Size = Vector3.new(6, 0.4, 1.8), CFrame = cf * CFrame.new(0, 1.9, 0), Color = S.Wood, Material = Enum.Material.Wood, Parent = m })
	Builder.decor({ Name = "Back", Size = Vector3.new(6, 1.6, 0.3), CFrame = cf * CFrame.new(0, 3, 0.95) * CFrame.Angles(math.rad(-10), 0, 0), Color = S.Wood, Material = Enum.Material.Wood, Parent = m })
	for _, x in { -2.6, 2.6 } do
		Builder.decor({ Name = "Leg", Size = Vector3.new(0.3, 1.8, 1.8), CFrame = cf * CFrame.new(x, 0.9, 0.1), Color = S.Metal, Material = Enum.Material.Metal, Parent = m })
	end
	return m
end

function Props.bin(parent: Instance, cf: CFrame)
	if AssetLibrary.spawn("Bin", parent, cf) then
		return
	end
	Builder.part({
		Name = "Bin",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.6, 1.4, 1.4),
		CFrame = cf * CFrame.new(0, 1.3, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(56, 96, 70),
		Material = Enum.Material.Metal,
		Parent = parent,
	})
end

-- Marquesina de autobús (la parte abierta mira hacia la calzada)
function Props.busStop(parent: Instance, cf: CFrame)
	local asset = AssetLibrary.spawn("BusStop", parent, cf)
	if asset then
		return asset
	end
	local m = Builder.model("BusStop", parent)
	Builder.decor({ Name = "Roof", Size = Vector3.new(10, 0.3, 4), CFrame = cf * CFrame.new(0, 8.2, 0), Color = S.Metal, Material = Enum.Material.Metal, Parent = m })
	Builder.part({ Name = "BackGlass", Size = Vector3.new(10, 6.5, 0.2), CFrame = cf * CFrame.new(0, 4.6, 1.8), Color = S.Glass, Material = Enum.Material.Glass, Transparency = 0.5, Parent = m })
	for _, x in { -4.9, 4.9 } do
		Builder.decor({ Name = "Post", Size = Vector3.new(0.3, 8, 0.3), CFrame = cf * CFrame.new(x, 4.1, 1.8), Color = S.Metal, Material = Enum.Material.Metal, Parent = m })
	end
	Builder.part({ Name = "Seat", Size = Vector3.new(6, 0.3, 1.2), CFrame = cf * CFrame.new(0, 2, 1.1), Color = S.Metal, Material = Enum.Material.Metal, Parent = m })
	local sign = Builder.decor({ Name = "Sign", Size = Vector3.new(2.4, 2.4, 0.2), CFrame = cf * CFrame.new(-6, 8, 0), Color = Color3.fromRGB(30, 110, 200), Parent = m })
	Builder.sign(sign, "BUS", Enum.NormalId.Front)
	Builder.sign(sign, "BUS", Enum.NormalId.Back)
	Builder.decor({ Name = "SignPost", Size = Vector3.new(0.25, 7, 0.25), CFrame = cf * CFrame.new(-6, 3.5, 0), Color = S.Metal, Material = Enum.Material.Metal, Parent = m })
	return m
end

-- Coche aparcado decorativo. El CFrame es el centro del coche a nivel de la calzada;
-- LookVector = morro.
function Props.car(parent: Instance, cf: CFrame, color: Color3?)
	local asset = AssetLibrary.spawn("Car", parent, cf)
	if asset then
		return asset
	end
	local m = Builder.model("ParkedCar", parent)
	local paint = color or Palette.pick(Palette.CarColors)
	local r = 1.3 -- radio de rueda
	Builder.part({ Name = "Body", Size = Vector3.new(6.2, 2.2, 13.5), CFrame = cf * CFrame.new(0, r + 0.9, 0), Color = paint, Material = Enum.Material.SmoothPlastic, Reflectance = 0.08, Parent = m })
	Builder.part({ Name = "Cabin", Size = Vector3.new(5.6, 2.1, 7), CFrame = cf * CFrame.new(0, r + 3, 0.6), Color = paint, Material = Enum.Material.SmoothPlastic, Reflectance = 0.08, Parent = m })
	local glassColor = Color3.fromRGB(40, 52, 62)
	Builder.decor({ Name = "SideWindows", Size = Vector3.new(5.7, 1.4, 6.2), CFrame = cf * CFrame.new(0, r + 3.1, 0.6), Color = glassColor, Material = Enum.Material.Glass, Parent = m })
	Builder.decor({ Name = "Windshield", Size = Vector3.new(5, 1.4, 7.1), CFrame = cf * CFrame.new(0, r + 3.1, 0.6), Color = glassColor, Material = Enum.Material.Glass, Parent = m })
	for _, z in { -4.3, 4.3 } do
		for _, x in { -2.9, 2.9 } do
			Builder.decor({
				Name = "Wheel",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(1.1, r * 2, r * 2),
				CFrame = cf * CFrame.new(x, r, z),
				Color = Color3.fromRGB(26, 26, 28),
				Material = Enum.Material.Rubber,
				Parent = m,
			})
		end
	end
	for _, x in { -2.2, 2.2 } do
		Builder.decor({ Name = "Headlight", Size = Vector3.new(1.2, 0.5, 0.2), CFrame = cf * CFrame.new(x, r + 1.4, -6.8), Color = Color3.fromRGB(255, 250, 230), Material = Enum.Material.Neon, Parent = m })
		Builder.decor({ Name = "Taillight", Size = Vector3.new(1.2, 0.5, 0.2), CFrame = cf * CFrame.new(x, r + 1.4, 6.8), Color = Color3.fromRGB(200, 30, 30), Material = Enum.Material.Neon, Parent = m })
	end
	return m
end

-- Tablón de empleo "SE BUSCA" (JobId debe existir en Config.Jobs)
function Props.jobBoard(parent: Instance, cf: CFrame, jobId: string, title: string)
	local m = Builder.model("JobBoard_" .. jobId, parent)
	for _, x in { -1.9, 1.9 } do
		Builder.part({ Name = "Post", Size = Vector3.new(0.3, 6.5, 0.3), CFrame = cf * CFrame.new(x, 3.25, 0), Color = S.Metal, Material = Enum.Material.Metal, Parent = m })
	end
	local board = Builder.part({
		Name = "Board",
		Size = Vector3.new(4.4, 3, 0.3),
		CFrame = cf * CFrame.new(0, 4.8, 0),
		Color = Color3.fromRGB(34, 108, 196),
		Tags = { "JobBoard" },
		Attributes = { JobId = jobId },
		Parent = m,
	})
	Builder.sign(board, "SE BUSCA\n" .. title, Enum.NormalId.Front)
	Builder.sign(board, "SE BUSCA\n" .. title, Enum.NormalId.Back)
	return m
end

return Props
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">Street</string>
              <string name="Source"><![CDATA[-- Street: red de calles alineadas con los ejes X y Z.
-- Genera asfalto con líneas, aceras elevadas con bordillo, cruces con pasos de
-- cebra y semáforos, farolas y árboles de alineación.
--
-- Cada calle se describe con:
--   { Axis = "X" | "Z", At = coordenada fija, From = inicio, To = fin,
--     Lamps = true, Trees = false }
-- "u" = posición a lo largo de la calle; "v" = posición transversal (0 = centro).

local Builder = require(script.Parent.Parent.Builder)
local Palette = require(script.Parent.Palette)
local Props = require(script.Parent.Props)
local Nature = require(script.Parent.Nature)

local Street = {}

Street.ROAD_WIDTH = 24
Street.SIDEWALK = 8
Street.HALF = Street.ROAD_WIDTH / 2 + Street.SIDEWALK -- 20: del centro al borde exterior de la acera
Street.ROAD_TOP = 0.4
Street.WALK_TOP = 1.0

local RW = Street.ROAD_WIDTH
local H = Street.HALF
local ROAD_TOP = Street.ROAD_TOP
local WALK_TOP = Street.WALK_TOP
local G = Palette.Ground

export type Road = { Axis: string, At: number, From: number, To: number, Lamps: boolean?, Trees: boolean? }

---------------------------------------------------------------------
-- Geometría
---------------------------------------------------------------------

-- Caja alineada con los ejes del mundo
local function wbox(parent: Instance, x0: number, x1: number, z0: number, z1: number, y0: number, y1: number, props: { [string]: any }, decor: boolean?): BasePart
	props.Size = Vector3.new(x1 - x0, y1 - y0, z1 - z0)
	props.CFrame = CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2)
	props.Parent = parent
	return if decor then Builder.decor(props) else Builder.part(props)
end

-- Caja en coordenadas de la calle (u a lo largo, v transversal)
local function rbox(parent: Instance, road: Road, u0: number, u1: number, v0: number, v1: number, y0: number, y1: number, props: { [string]: any }, decor: boolean?): BasePart
	if road.Axis == "X" then
		return wbox(parent, u0, u1, road.At + v0, road.At + v1, y0, y1, props, decor)
	end
	return wbox(parent, road.At + v0, road.At + v1, u0, u1, y0, y1, props, decor)
end

function Street.point(road: Road, u: number, v: number, y: number): Vector3
	if road.Axis == "X" then
		return Vector3.new(u, y, road.At + v)
	end
	return Vector3.new(road.At + v, y, u)
end

-- Dirección transversal (hacia +v o -v)
function Street.across(road: Road, sign: number): Vector3
	return if road.Axis == "X" then Vector3.new(0, 0, sign) else Vector3.new(sign, 0, 0)
end

function Street.along(road: Road, sign: number): Vector3
	return if road.Axis == "X" then Vector3.new(sign, 0, 0) else Vector3.new(0, 0, sign)
end

local function asphalt()
	return { Name = "Road", Color = G.Asphalt, Material = Enum.Material.Asphalt }
end
local function pavement()
	return { Name = "Sidewalk", Color = G.Sidewalk, Material = Enum.Material.Pavement }
end
local function curb()
	return { Name = "Curb", Color = G.Curb, Material = Enum.Material.Concrete }
end
local function marking(yellow: boolean?)
	return { Name = "Marking", Color = if yellow then G.MarkingYellow else G.Marking, Material = Enum.Material.SmoothPlastic }
end

---------------------------------------------------------------------
-- Tramos
---------------------------------------------------------------------

local function segment(parent: Instance, road: Road, u0: number, u1: number)
	local length = u1 - u0
	if length < 1 then
		return
	end
	rbox(parent, road, u0, u1, -RW / 2, RW / 2, 0, ROAD_TOP, asphalt())
	for _, s in { -1, 1 } do
		local inner, outer = s * RW / 2, s * H
		rbox(parent, road, u0, u1, math.min(inner, outer), math.max(inner, outer), 0, WALK_TOP, pavement())
		local c0, c1 = s * (RW / 2 - 0.05), s * (RW / 2 + 0.55)
		rbox(parent, road, u0, u1, math.min(c0, c1), math.max(c0, c1), ROAD_TOP, WALK_TOP + 0.05, curb())
		-- Línea continua de borde
		local e0, e1 = s * (RW / 2 - 1.4), s * (RW / 2 - 1.0)
		rbox(parent, road, u0, u1, math.min(e0, e1), math.max(e0, e1), ROAD_TOP, ROAD_TOP + 0.04, marking(), true)
	end
	-- Línea discontinua central
	local u = u0 + 3
	while u + 6 <= u1 - 3 do
		rbox(parent, road, u, u + 6, -0.25, 0.25, ROAD_TOP, ROAD_TOP + 0.04, marking(), true)
		u += 12
	end

	-- Farolas al tresbolillo y árboles de alineación
	if road.Lamps ~= false then
		local i = 0
		local lu = u0 + 12
		while lu <= u1 - 8 do
			local s = if i % 2 == 0 then 1 else -1
			local pos = Street.point(road, lu, s * (RW / 2 + 1.8), WALK_TOP)
			Props.lamp(parent, Builder.facing(pos, Street.across(road, -s)))
			if i % 3 == 1 then
				local binPos = Street.point(road, lu + 3, s * (RW / 2 + 1.8), WALK_TOP)
				Props.bin(parent, CFrame.new(binPos))
			end
			i += 1
			lu += 36
		end
	end
	if road.Trees then
		local tu = u0 + 30
		while tu <= u1 - 8 do
			for _, s in { -1, 1 } do
				local v = s * (H - 2.6)
				rbox(parent, road, tu - 1.8, tu + 1.8, v - 1.8, v + 1.8, WALK_TOP, WALK_TOP + 0.05, { Name = "TreePit", Color = Color3.fromRGB(84, 64, 46), Material = Enum.Material.Ground }, true)
				Nature.tree(parent, Street.point(road, tu, v, WALK_TOP), 0.75 + math.random() * 0.2)
			end
			tu += 36
		end
	end
end

---------------------------------------------------------------------
-- Cruces
---------------------------------------------------------------------

type Arms = { West: boolean, East: boolean, North: boolean, South: boolean }

local function zebra(parent: Instance, x0: number, x1: number, z0: number, z1: number, alongX: boolean)
	-- Franjas paralelas al tráfico, repartidas a lo ancho de la calzada
	if alongX then
		local z = z0 + 1.5
		while z + 1.5 <= z1 do
			wbox(parent, x0 + 1, x1 - 1, z - 0.8, z + 0.8, ROAD_TOP, ROAD_TOP + 0.04, marking(), true)
			z += 3
		end
	else
		local x = x0 + 1.5
		while x + 1.5 <= x1 do
			wbox(parent, x - 0.8, x + 0.8, z0 + 1, z1 - 1, ROAD_TOP, ROAD_TOP + 0.04, marking(), true)
			x += 3
		end
	end
end

local function intersection(parent: Instance, cx: number, cz: number, arms: Arms)
	local r = RW / 2
	wbox(parent, cx - r, cx + r, cz - r, cz + r, 0, ROAD_TOP, asphalt())

	local strips = {
		{ Open = arms.West, X0 = cx - H, X1 = cx - r, Z0 = cz - r, Z1 = cz + r, AlongX = true },
		{ Open = arms.East, X0 = cx + r, X1 = cx + H, Z0 = cz - r, Z1 = cz + r, AlongX = true },
		{ Open = arms.North, X0 = cx - r, X1 = cx + r, Z0 = cz - H, Z1 = cz - r, AlongX = false },
		{ Open = arms.South, X0 = cx - r, X1 = cx + r, Z0 = cz + r, Z1 = cz + H, AlongX = false },
	}
	for _, s in strips do
		if s.Open then
			wbox(parent, s.X0, s.X1, s.Z0, s.Z1, 0, ROAD_TOP, asphalt())
			zebra(parent, s.X0, s.X1, s.Z0, s.Z1, s.AlongX)
		else
			wbox(parent, s.X0, s.X1, s.Z0, s.Z1, 0, WALK_TOP, pavement())
		end
	end

	-- Esquinas de acera con bordillo
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local x0, x1 = math.min(cx + sx * r, cx + sx * H), math.max(cx + sx * r, cx + sx * H)
			local z0, z1 = math.min(cz + sz * r, cz + sz * H), math.max(cz + sz * r, cz + sz * H)
			wbox(parent, x0, x1, z0, z1, 0, WALK_TOP, pavement())
			local ex = cx + sx * r -- borde hacia la calle N-S
			local ez = cz + sz * r -- borde hacia la calle E-O
			wbox(parent, math.min(ex, ex + sx * 0.6), math.max(ex, ex + sx * 0.6), z0, z1, ROAD_TOP, WALK_TOP + 0.05, curb())
			wbox(parent, x0, x1, math.min(ez, ez + sz * 0.6), math.max(ez, ez + sz * 0.6), ROAD_TOP, WALK_TOP + 0.05, curb())
		end
	end

	-- Semáforos en dos esquinas opuestas
	local p1 = Vector3.new(cx + r + 1.5, WALK_TOP, cz + r + 1.5)
	Props.trafficLight(parent, Builder.facing(p1, Vector3.new(0, 0, -1)), 11)
	local p2 = Vector3.new(cx - r - 1.5, WALK_TOP, cz - r - 1.5)
	Props.trafficLight(parent, Builder.facing(p2, Vector3.new(1, 0, 0)), 11)
end

---------------------------------------------------------------------

function Street.build(parent: Instance, roads: { Road })
	local folder = Builder.model("Streets", parent)
	local cuts: { [Road]: { number } } = {}
	for _, road in roads do
		cuts[road] = {}
	end

	for _, a in roads do
		if a.Axis == "X" then
			for _, b in roads do
				if b.Axis == "Z" and b.At >= a.From and b.At <= a.To and a.At >= b.From and a.At <= b.To then
					table.insert(cuts[a], b.At)
					table.insert(cuts[b], a.At)
					intersection(folder, b.At, a.At, {
						West = a.From < b.At - H,
						East = a.To > b.At + H,
						North = b.From < a.At - H,
						South = b.To > a.At + H,
					})
				end
			end
		end
	end

	for _, road in roads do
		local list = cuts[road]
		table.sort(list)
		local start = road.From
		for _, c in list do
			segment(folder, road, start, c - H)
			start = c + H
		end
		segment(folder, road, start, road.To)
	end
	return folder
end

-- Aparca coches en el borde de una calle, entre u0 y u1, en el lado "side" (+1/-1)
function Street.parkCars(parent: Instance, road: Road, u0: number, u1: number, side: number, chance: number?)
	local u = u0 + 8
	while u <= u1 - 8 do
		if math.random() < (chance or 0.6) then
			local pos = Street.point(road, u, side * (RW / 2 - 3.6), ROAD_TOP)
			local heading = Street.along(road, if side > 0 then 1 else -1)
			Props.car(parent, Builder.facing(pos, heading))
		end
		u += 16
	end
end

return Street
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">TerrainBuilder</string>
            <string name="Source"><![CDATA[-- TerrainBuilder: sustituye el suelo de piezas por terreno real de Roblox
-- (hierba con textura y colinas en el horizonte). Se ejecuta al arrancar el servidor,
-- porque el terreno no se puede guardar desde el script que genera el archivo.

local TerrainBuilder = {}

function TerrainBuilder.build()
	local terrain = workspace.Terrain
	-- Sin briznas de hierba: atravesarían las calles y los suelos
	pcall(function()
		terrain.Decoration = false
	end)
	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(98, 146, 70))
	terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(128, 122, 112))

	-- Llanura: la superficie queda justo en Y = 0
	terrain:FillBlock(CFrame.new(0, -4, 0), Vector3.new(1200, 8, 1200), Enum.Material.Grass)

	-- Colinas en el horizonte (cierran el mapa sin muros invisibles)
	local count = 44
	for i = 1, count do
		local angle = i / count * math.pi * 2
		local distance = 560 + math.random(0, 90)
		local radius = 70 + math.random(0, 60)
		local center = Vector3.new(math.cos(angle) * distance, -radius * 0.45, math.sin(angle) * distance)
		terrain:FillBall(center, radius, if math.random() < 0.2 then Enum.Material.Rock else Enum.Material.Grass)
	end
end

-- El suelo de piezas de la ciudad solo sirve para verla en Studio: en el juego se quita
function TerrainBuilder.removeGroundPart()
	local town = workspace:FindFirstChild("Town")
	local ground = town and town:FindFirstChild("Ground")
	if ground then
		ground:Destroy()
	end
end

return TerrainBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">TownBuilder</string>
            <string name="Source"><![CDATA[-- TownBuilder: construye la ciudad de Valmar (prototipo) con los kits de /Kit.
--
-- Mapa (vista desde arriba, el norte es -Z):
--
--   Punto Limpio · edificios · Mega Burger · PLAZA | edificios · Cafetería · Supermercado · Correos
--   ========================== AVENIDA (z = 0) ===========================================
--   Casas 1-8 (fila 1)                             |
--   ========================== CALLE RESIDENCIAL (z = 120) ===============================
--   Casas 9-16 (fila 2)                            |
--                                           CALLE N-S (x = 0)
--
-- Todo lo que usa la jugabilidad se marca con tags (CollectionService):
--   JobBoard (+JobId), Pickup_<Trabajo>, Dropoff_<Trabajo>, FoodStand (+FoodId),
--   StreetLamp, NightWindow, Plot (+PlotId), PlotSign (+PlotId)

local Builder = require(script.Parent.Builder)
local Kit = script.Parent.Kit
local Palette = require(Kit.Palette)
local Street = require(Kit.Street)
local Building = require(Kit.Building)
local Nature = require(Kit.Nature)
local Props = require(Kit.Props)
local AssetLibrary = require(Kit.AssetLibrary)

local TownBuilder = {}

local WALK = Street.WALK_TOP
local PLOT_SIZE = 50
local rgb = Color3.fromRGB

local NORTH = Vector3.new(0, 0, -1)
local SOUTH = Vector3.new(0, 0, 1)
local EAST = Vector3.new(1, 0, 0)
local WEST = Vector3.new(-1, 0, 0)

local function facing(position: Vector3, direction: Vector3): CFrame
	return Builder.facing(position, direction)
end

local ROADS = {
	Avenue = { Axis = "X", At = 0, From = -340, To = 340, Lamps = true, Trees = false },
	Residential = { Axis = "X", At = 120, From = -340, To = 340, Lamps = true, Trees = true },
	NorthSouth = { Axis = "Z", At = 0, From = -190, To = 260, Lamps = true, Trees = false },
}

-- Fachada a ras de la acera norte de la avenida: devuelve el CFrame del edificio
local function northOfAvenue(x: number, depth: number): CFrame
	return facing(Vector3.new(x, 0, -Street.HALF - depth / 2), SOUTH)
end

---------------------------------------------------------------------
-- Mobiliario interior de los negocios
---------------------------------------------------------------------

local function counter(parent: Instance, cf: CFrame, width: number, color: Color3)
	Builder.part({ Name = "Counter", Size = Vector3.new(width, 3.6, 3), CFrame = cf * CFrame.new(0, 1.8, 0), Color = color, Material = Enum.Material.Wood, Parent = parent })
	Builder.part({ Name = "CounterTop", Size = Vector3.new(width + 0.4, 0.3, 3.4), CFrame = cf * CFrame.new(0, 3.75, 0), Color = rgb(236, 234, 228), Material = Enum.Material.Marble, Parent = parent })
end

local function foodStand(parent: Instance, cf: CFrame, foodId: string, color: Color3)
	Builder.part({
		Name = "Food_" .. foodId,
		Size = Vector3.new(1.6, 1.2, 1.6),
		CFrame = cf,
		Color = color,
		Tags = { "FoodStand" },
		Attributes = { FoodId = foodId },
		Parent = parent,
	})
end

local function cafeTable(parent: Instance, cf: CFrame, tag: string?)
	local m = Builder.model("Table", parent)
	Builder.part({
		Name = "Top",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 4.4, 4.4),
		CFrame = cf * CFrame.new(0, 3, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = rgb(236, 232, 224),
		Material = Enum.Material.Marble,
		Tags = if tag then { tag } else nil,
		Parent = m,
	})
	Builder.decor({ Name = "Leg", Size = Vector3.new(0.4, 2.8, 0.4), CFrame = cf * CFrame.new(0, 1.5, 0), Color = Palette.Street.Metal, Material = Enum.Material.Metal, Parent = m })
	for _, dir in { -1, 1 } do
		local chair = cf * CFrame.new(dir * 3.4, 0, 0) * CFrame.Angles(0, if dir > 0 then math.rad(90) else math.rad(-90), 0)
		Builder.part({ Name = "Seat", Size = Vector3.new(2, 0.3, 2), CFrame = chair * CFrame.new(0, 1.9, 0), Color = rgb(150, 100, 64), Material = Enum.Material.Wood, Parent = m })
		Builder.decor({ Name = "Back", Size = Vector3.new(2, 2, 0.25), CFrame = chair * CFrame.new(0, 3, -0.9), Color = rgb(150, 100, 64), Material = Enum.Material.Wood, Parent = m })
		for _, lx in { -0.8, 0.8 } do
			for _, lz in { -0.8, 0.8 } do
				Builder.decor({ Name = "ChairLeg", Size = Vector3.new(0.2, 1.8, 0.2), CFrame = chair * CFrame.new(lx, 0.9, lz), Color = Palette.Street.Metal, Parent = m })
			end
		end
	end
end

---------------------------------------------------------------------
-- Negocios
---------------------------------------------------------------------

local function buildCafe(world: Instance)
	local W, D = 44, 34
	local model, at = Building.build({
		Name = "Cafeteria", Parent = world, CFrame = northOfAvenue(70, D),
		Width = W, Depth = D, Floors = 4, Style = "Clasico", GroundFloor = "Shop",
		WindowFaces = { Front = true, Left = true, Right = true },
		Sign = "CAFETERÍA CENTRAL", SignColor = rgb(96, 60, 38), Awning = rgb(110, 66, 40),
		FloorMaterial = Enum.Material.WoodPlanks, FloorColor = rgb(150, 108, 72),
	})
	counter(model, at(0, 0, 11), 26, rgb(96, 60, 38))
	Builder.part({
		Name = "CoffeeMachine", Size = Vector3.new(3, 3, 2), CFrame = at(-9, 5.4, 11),
		Color = rgb(60, 60, 66), Material = Enum.Material.Metal, Tags = { "Pickup_Barista" }, Parent = model,
	})
	foodStand(model, at(4, 4.5, 10.5), "Cafe", rgb(96, 60, 38))
	foodStand(model, at(9, 4.5, 10.5), "Croissant", rgb(222, 170, 90))
	for _, p in { { -12, -8 }, { 0, -8 }, { 12, -8 }, { -12, 1 }, { 12, 1 } } do
		cafeTable(model, at(p[1], 0, p[2]), "Dropoff_Barista")
	end
	Props.jobBoard(world, at(10, 0, -D / 2 - 3.5) * CFrame.Angles(0, math.pi, 0), "Barista", "BARISTA")
	-- Terraza en la acera
	cafeTable(world, at(-14, 0, -D / 2 - 4), nil)
end

local function buildSupermarket(world: Instance)
	local W, D = 60, 48
	local model, at = Building.build({
		Name = "Supermercado", Parent = world, CFrame = northOfAvenue(160, D),
		Width = W, Depth = D, Floors = 2, Style = "Moderno", GroundFloor = "Shop", Balconies = false,
		WindowFaces = { Front = true, Left = true, Right = true },
		Sign = "SUPERMERCADO", SignColor = rgb(36, 132, 76), Awning = rgb(36, 132, 76),
		FloorMaterial = Enum.Material.CeramicTiles, FloorColor = rgb(226, 226, 222),
		LightColor = rgb(240, 248, 255),
	})
	for i, x in { -20, -8, 4 } do
		for j, z in { -6, 8 } do
			local shelf = Builder.part({
				Name = "Shelf" .. i .. j, Size = Vector3.new(3, 7, 10), CFrame = at(x, 3.5, z),
				Color = rgb(206, 206, 210), Material = Enum.Material.Metal, Tags = { "Dropoff_Reponedor" }, Parent = model,
			})
			for k = 0, 2 do
				Builder.decor({
					Name = "Products", Size = Vector3.new(3.4, 1, 9), CFrame = shelf.CFrame * CFrame.new(0, -2 + k * 2.2, 0),
					Color = Color3.fromHSV(math.random(), 0.55, 0.9), Parent = model,
				})
			end
		end
	end
	for _, x in { 20, 25 } do
		Builder.part({
			Name = "StockBoxes", Size = Vector3.new(4, 4, 4), CFrame = at(x, 2, 18),
			Color = rgb(190, 150, 90), Material = Enum.Material.Cardboard, Tags = { "Pickup_Reponedor" }, Parent = model,
		})
	end
	counter(model, at(20, 0, -12), 10, rgb(36, 132, 76))
	foodStand(model, at(17, 4.5, -12), "Fruta", rgb(226, 60, 60))
	foodStand(model, at(22, 4.5, -12), "Bocadillo", rgb(226, 190, 120))
	Props.jobBoard(world, at(-22, 0, -D / 2 - 3.5) * CFrame.Angles(0, math.pi, 0), "Reponedor", "REPONEDOR")
end

local function buildPostOffice(world: Instance)
	local W, D = 40, 30
	local model, at = Building.build({
		Name = "Correos", Parent = world, CFrame = northOfAvenue(255, D),
		Width = W, Depth = D, Floors = 3, Style = "Clasico", GroundFloor = "Shop", WallColor = rgb(238, 204, 96),
		WindowFaces = { Front = true, Left = true, Right = true },
		Sign = "CORREOS", SignColor = rgb(30, 60, 140), Awning = rgb(30, 60, 140),
	})
	counter(model, at(0, 0, 3), 20, rgb(30, 60, 140))
	Builder.part({
		Name = "Parcels", Size = Vector3.new(10, 5, 4), CFrame = at(0, 2.5, 11),
		Color = rgb(170, 120, 70), Material = Enum.Material.Cardboard, Tags = { "Pickup_Repartidor" }, Parent = model,
	})
	Props.jobBoard(world, at(10, 0, -D / 2 - 3.5) * CFrame.Angles(0, math.pi, 0), "Repartidor", "REPARTIDOR")
end

local function buildBurger(world: Instance)
	local W, D = 40, 32
	local model, at = Building.build({
		Name = "MegaBurger", Parent = world, CFrame = northOfAvenue(-150, D),
		Width = W, Depth = D, Floors = 2, Style = "Popular", GroundFloor = "Shop", WallColor = rgb(196, 58, 48),
		WindowFaces = { Front = true, Left = true, Right = true },
		Sign = "MEGA BURGER", SignColor = rgb(240, 186, 40), Awning = rgb(240, 186, 40),
		FloorMaterial = Enum.Material.CeramicTiles, FloorColor = rgb(230, 222, 206),
	})
	counter(model, at(0, 0, 10), 22, rgb(240, 186, 40))
	foodStand(model, at(-4, 4.5, 9.5), "Hamburguesa", rgb(170, 100, 50))
	foodStand(model, at(4, 4.5, 9.5), "Menu", rgb(226, 60, 50))
	for _, p in { { -11, -6 }, { 11, -6 }, { 0, -1 } } do
		cafeTable(model, at(p[1], 0, p[2]), nil)
	end
end

---------------------------------------------------------------------
-- Edificios de viviendas y comercios cerrados (relleno urbano)
---------------------------------------------------------------------

local SHOP_NAMES = { "FARMACIA", "PANADERÍA", "ZAPATERÍA", "BANCO VALMAR", "INMOBILIARIA", "FLORISTERÍA", "LIBRERÍA", "PELUQUERÍA", "FERRETERÍA", "ÓPTICA" }
local AWNINGS = { rgb(170, 40, 40), rgb(40, 90, 150), rgb(40, 120, 70), rgb(200, 150, 40), rgb(90, 60, 110) }
local STYLES = { "Clasico", "Popular", "Moderno", "Clasico", "Popular" }

local function filler(world: Instance, cf: CFrame, width: number, index: number)
	local style = STYLES[(index - 1) % #STYLES + 1]
	local isShop = math.random() < 0.55
	Building.build({
		Name = "Edificio_" .. index,
		Parent = world,
		CFrame = cf,
		Width = width,
		Depth = 28,
		Floors = math.random(3, 6),
		Style = style,
		GroundFloor = if isShop then "Shop" else "Closed",
		Interior = false,
		WindowFaces = { Front = true, Left = true, Right = true },
		Sign = if isShop then SHOP_NAMES[math.random(1, #SHOP_NAMES)] else nil,
		Awning = if isShop then Palette.pick(AWNINGS) else nil,
	})
end

local function buildFillers(world: Instance)
	local folder = Builder.model("Edificios", world)
	local index = 0
	-- Acera norte de la avenida (x, ancho)
	for _, spec in { { -310, 36 }, { -199, 34 }, { -111, 30 }, { 34, 24 }, { 111, 34 }, { 212, 38 }, { 306, 56 } } do
		index += 1
		filler(folder, northOfAvenue(spec[1], 28), spec[2], index)
	end
	-- Calle N-S, tramo norte (fachadas mirando a la calle)
	for _, spec in { { 1, -86, 34 }, { 1, -126, 34 }, { 1, -164, 30 }, { -1, -104, 34 }, { -1, -144, 34 } } do
		index += 1
		local side, z, width = spec[1], spec[2], spec[3]
		local pos = Vector3.new(side * (Street.HALF + 14), 0, z)
		filler(folder, facing(pos, if side > 0 then WEST else EAST), width, index)
	end
end

---------------------------------------------------------------------
-- Plaza mayor (punto de aparición)
---------------------------------------------------------------------

local function buildPlaza(world: Instance)
	local plaza = Builder.model("Plaza", world)
	local cx, cz = -60, -52
	local x0, x1, z0, z1 = -90, -30, -82, -20
	Builder.part({
		Name = "PlazaFloor",
		Size = Vector3.new(x1 - x0, WALK, z1 - z0),
		CFrame = CFrame.new((x0 + x1) / 2, WALK / 2, (z0 + z1) / 2),
		Color = Palette.Ground.Plaza,
		Material = Enum.Material.Pavement,
		Parent = plaza,
	})

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 0.2, 10)
	spawn.CFrame = CFrame.new(cx, WALK + 0.1, -32)
	spawn.Color = Palette.Ground.Plaza
	spawn.Material = Enum.Material.Pavement
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = plaza

	-- Fuente de dos pisos
	local f = Vector3.new(cx, WALK, cz - 4)
	local stone = rgb(226, 222, 212)
	local function disc(name: string, height: number, diameter: number, y: number, color: Color3, material: Enum.Material, transparency: number?)
		Builder.part({
			Name = name,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(height, diameter, diameter),
			CFrame = CFrame.new(f + Vector3.new(0, y, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = color,
			Material = material,
			Transparency = transparency or 0,
			CanCollide = transparency == nil,
			Parent = plaza,
		})
	end
	disc("FountainRim", 2.2, 22, 1.1, stone, Enum.Material.Limestone)
	disc("FountainWater", 0.3, 20.4, 1.9, rgb(70, 150, 210), Enum.Material.Glass, 0.25)
	disc("FountainColumn", 6, 2.4, 4, stone, Enum.Material.Limestone)
	disc("FountainBowl", 1, 9, 6.8, stone, Enum.Material.Limestone)
	disc("FountainBowlWater", 0.2, 8, 7.35, rgb(70, 150, 210), Enum.Material.Glass, 0.25)
	disc("FountainTop", 2.4, 1.2, 8.4, stone, Enum.Material.Limestone)

	-- Palmeras, bancos y parterres
	for _, p in { { -84, -76 }, { -36, -76 }, { -84, -30 }, { -36, -30 }, { -84, -53 }, { -36, -53 } } do
		Nature.palm(plaza, Vector3.new(p[1], WALK, p[2]))
	end
	for _, b in { { -74, -56, EAST }, { -46, -56, WEST }, { -60, -70, SOUTH } } do
		Props.bench(plaza, facing(Vector3.new(b[1], WALK, b[2]), b[3]))
	end
	Nature.flowerBed(plaza, CFrame.new(-74, WALK, -40), 8, 4)
	Nature.flowerBed(plaza, CFrame.new(-46, WALK, -40), 8, 4)
	Nature.flowerBed(plaza, CFrame.new(-60, WALK, -78), 16, 3)

	-- Cartel de bienvenida (mira hacia el punto de aparición)
	local welcome = Builder.part({
		Name = "WelcomeSign",
		Size = Vector3.new(22, 4.5, 0.6),
		CFrame = facing(Vector3.new(cx, WALK + 8, -80), SOUTH),
		Color = rgb(28, 34, 48),
		Parent = plaza,
	})
	Builder.sign(welcome, "Bienvenido a VALMAR", Enum.NormalId.Front)
	for _, x in { -10, 10 } do
		Builder.part({ Name = "SignPost", Size = Vector3.new(0.8, 10, 0.8), CFrame = CFrame.new(cx + x, WALK + 5, -80), Color = Palette.Street.Metal, Material = Enum.Material.Metal, Parent = plaza })
	end
end

---------------------------------------------------------------------
-- Punto Limpio y bolsas de basura
---------------------------------------------------------------------

local function buildRecycling(world: Instance)
	local area = Builder.model("PuntoLimpio", world)
	local cx = -240
	Builder.part({
		Name = "Yard", Size = Vector3.new(40, WALK, 38), CFrame = CFrame.new(cx, WALK / 2, -39),
		Color = rgb(128, 128, 124), Material = Enum.Material.Concrete, Parent = area,
	})
	local colors = { rgb(40, 120, 60), rgb(40, 80, 160), rgb(220, 180, 40) }
	for i, x in { -12, 0, 12 } do
		Builder.part({
			Name = "Container" .. i, Size = Vector3.new(9, 6, 5), CFrame = CFrame.new(cx + x, WALK + 3, -50),
			Color = colors[i], Material = Enum.Material.Metal, Tags = { "Dropoff_Basurero" }, Parent = area,
		})
	end
	for _, x in { -20, 20 } do
		Builder.part({ Name = "Fence", Size = Vector3.new(0.4, 5, 36), CFrame = CFrame.new(cx + x, WALK + 2.5, -40), Color = Palette.Street.Metal, Material = Enum.Material.DiamondPlate, Parent = area })
	end
	local sign = Builder.part({ Name = "Sign", Size = Vector3.new(16, 3, 0.4), CFrame = facing(Vector3.new(cx, WALK + 9.5, -53), SOUTH), Color = rgb(40, 120, 60), Parent = area })
	Builder.sign(sign, "PUNTO LIMPIO", Enum.NormalId.Front)
	Props.jobBoard(world, facing(Vector3.new(cx + 12, WALK, -24), SOUTH), "Basurero", "BASURERO")

	local bags = Builder.model("TrashBags", world)
	local spots = {
		Vector3.new(-300, 0, 16), Vector3.new(-200, 0, 16), Vector3.new(-100, 0, 16), Vector3.new(120, 0, 16),
		Vector3.new(300, 0, 16), Vector3.new(40, 0, -16), Vector3.new(220, 0, -16), Vector3.new(-250, 0, 104),
		Vector3.new(-60, 0, 136), Vector3.new(90, 0, 104), Vector3.new(260, 0, 136), Vector3.new(16, 0, 200),
		Vector3.new(-16, 0, -70),
	}
	for i, spot in spots do
		Builder.part({
			Name = "TrashBag" .. i, Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4),
			CFrame = CFrame.new(spot + Vector3.new(0, WALK + 1.1, 0)), Color = rgb(24, 24, 28),
			Material = Enum.Material.Plastic, CanCollide = false, Tags = { "Pickup_Basurero" }, Parent = bags,
		})
	end
end

---------------------------------------------------------------------
-- Parcelas residenciales
---------------------------------------------------------------------

-- Tamaños de las casas de muestra (los mismos que los dos primeros niveles de Config.HouseTiers)
local SHOW_HOUSES = { Vector3.new(24, 12, 20), Vector3.new(32, 14, 28) }

function TownBuilder.showHouse(plot: Instance, origin: CFrame): Model
	local size = SHOW_HOUSES[math.random(1, #SHOW_HOUSES)]
	local model = Building.build({
		Name = "House",
		Parent = plot,
		CFrame = origin * CFrame.new(0, 0, PLOT_SIZE / 2 - size.Z / 2 - 3),
		Width = size.X,
		Depth = size.Z,
		Floors = 1,
		Style = "Casa",
		GroundFloor = "House",
		Interior = false,
	})
	model:SetAttribute("ShowHouse", true)
	return model
end

local function buildPlot(parent: Instance, plotId: number, center: Vector3)
	local cf = facing(center, NORTH) -- todas las casas miran a la calle del norte
	local plot = Builder.model("Plot_" .. plotId, parent)
	plot:SetAttribute("PlotId", plotId)
	plot:SetAttribute("Origin", cf)
	plot:AddTag("Plot")
	local half = PLOT_SIZE / 2

	Builder.part({
		Name = "Lawn", Size = Vector3.new(PLOT_SIZE, 0.3, PLOT_SIZE), CFrame = cf * CFrame.new(0, 0.15, 0),
		Color = Palette.Ground.Lawn, Material = Enum.Material.Grass, Parent = plot,
	})
	-- Camino desde la acera hasta la puerta
	Builder.part({
		Name = "Path", Size = Vector3.new(5, 0.4, 36), CFrame = cf * CFrame.new(0, 0.2, -half - 2),
		Color = rgb(200, 190, 172), Material = Enum.Material.Pavement, Parent = plot,
	})
	-- Setos en los laterales y al fondo
	Nature.hedge(plot, (cf * CFrame.new(-half + 0.8, 0, -half + 4)).Position, (cf * CFrame.new(-half + 0.8, 0, half - 0.8)).Position)
	Nature.hedge(plot, (cf * CFrame.new(half - 0.8, 0, -half + 4)).Position, (cf * CFrame.new(half - 0.8, 0, half - 0.8)).Position)
	Nature.hedge(plot, (cf * CFrame.new(-half + 1.6, 0, half - 0.8)).Position, (cf * CFrame.new(half - 1.6, 0, half - 0.8)).Position)

	-- Buzón (destino del repartidor)
	Builder.part({ Name = "MailboxPost", Size = Vector3.new(0.4, 3.5, 0.4), CFrame = cf * CFrame.new(5, 1.75, -half + 1), Color = Palette.Street.Wood, Parent = plot })
	Builder.part({
		Name = "Mailbox", Size = Vector3.new(1.2, 1.2, 2), CFrame = cf * CFrame.new(5, 4, -half + 1),
		Color = rgb(196, 48, 48), Tags = { "Dropoff_Repartidor" }, Parent = plot,
	})
	-- Cartel de la parcela (reclamar / mejorar casa)
	Builder.part({ Name = "SignPost", Size = Vector3.new(0.4, 4, 0.4), CFrame = cf * CFrame.new(-6, 2, -half + 1), Color = Palette.Street.Wood, Parent = plot })
	local sign = Builder.part({
		Name = "PlotSign", Size = Vector3.new(5, 2.6, 0.3), CFrame = cf * CFrame.new(-6, 4.8, -half + 1),
		Color = rgb(246, 246, 240), Tags = { "PlotSign" }, Attributes = { PlotId = plotId }, Parent = plot,
	})
	local label = Builder.sign(sign, "SE VENDE\nLibre", Enum.NormalId.Front, rgb(30, 30, 30))
	label.Name = "Label"

	-- Casa "en venta" hasta que alguien reclama la parcela (HouseService la sustituye)
	TownBuilder.showHouse(plot, cf)

	-- Jardín
	Nature.tree(plot, (cf * CFrame.new(-half + 6, 0, half - 6)).Position)
	Nature.cypress(plot, (cf * CFrame.new(half - 5, 0, half - 5)).Position)
	for _, x in { -12, 12 } do
		Nature.bush(plot, (cf * CFrame.new(x, 0.3, -half + 5)).Position)
	end
end

local function buildPlots(world: Instance)
	local plots = Instance.new("Folder")
	plots.Name = "Plots"
	plots.Parent = world
	local xs = { -270, -200, -130, -60, 60, 130, 200, 270 }
	local id = 0
	for _, rowZ in { 65, 185 } do
		for _, x in xs do
			id += 1
			buildPlot(plots, id, Vector3.new(x, 0, rowZ))
		end
	end
end

---------------------------------------------------------------------
-- Vida en la calle: coches aparcados y paradas de autobús
---------------------------------------------------------------------

local function buildStreetLife(world: Instance)
	local folder = Builder.model("StreetLife", world)
	local H = Street.HALF
	Street.parkCars(folder, ROADS.Residential, -336, -H - 4, 1, 0.3)
	Street.parkCars(folder, ROADS.Residential, H + 4, 336, 1, 0.3)
	Street.parkCars(folder, ROADS.Residential, -336, -H - 4, -1, 0.2)
	Street.parkCars(folder, ROADS.Residential, H + 4, 336, -1, 0.2)
	Street.parkCars(folder, ROADS.Avenue, -336, -H - 4, 1, 0.25)
	Street.parkCars(folder, ROADS.Avenue, H + 4, 336, 1, 0.25)
	for _, x in { -130, 86 } do
		Props.busStop(folder, facing(Vector3.new(x, WALK, 17.4), NORTH))
	end
end

---------------------------------------------------------------------

local function buildGround(world: Instance)
	-- En el juego se sustituye por terreno real (TerrainBuilder); aquí sirve para verlo en Studio
	Builder.part({
		Name = "Ground", Size = Vector3.new(1000, 2, 1000), CFrame = CFrame.new(0, -1, 0),
		Color = Palette.Ground.Grass, Material = Enum.Material.Grass, Parent = world,
	})
end

local function buildOutskirts(world: Instance)
	local folder = Builder.model("Afueras", world)
	for _ = 1, 70 do
		local x = math.random(-470, 470)
		local z = math.random(-470, 470)
		local inTown = math.abs(x) < 350 and z > -200 and z < 225
		if not inTown and math.abs(x) > 25 then
			if math.random() < 0.3 then
				Nature.cypress(folder, Vector3.new(x, 0, z))
			else
				Nature.tree(folder, Vector3.new(x, 0, z), 1 + math.random() * 0.4)
			end
		end
	end
end

function TownBuilder.build(): Folder
	local world = Instance.new("Folder")
	world.Name = "Town"
	-- Recuerda si se construyó con modelos importados (packs de Synty) o solo por código
	world:SetAttribute("BuiltWithAssets", AssetLibrary.has("Tree") or AssetLibrary.has("Lamp") or AssetLibrary.has("Car"))
	world.Parent = workspace

	buildGround(world)
	Street.build(world, { ROADS.Avenue, ROADS.Residential, ROADS.NorthSouth })
	buildPlaza(world)
	buildCafe(world)
	buildSupermarket(world)
	buildPostOffice(world)
	buildBurger(world)
	buildFillers(world)
	buildRecycling(world)
	buildPlots(world)
	buildStreetLife(world)
	buildOutskirts(world)

	return world
end

return TownBuilder
]]></string>
